+			auto *b = w.addBuilding("inn", 8, 8);
+			b->maxUnitWorking = 0;
+			b->updateCallLists();
+			auto *u = w.addUnit(WORKER, 60, 8);
+			u->medical = Unit::MED_HUNGRY;
