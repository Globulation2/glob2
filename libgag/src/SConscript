from sources import GAG_SOURCES
libgag_sources = list(GAG_SOURCES)
import sys
if sys.platform == "darwin":
    libgag_sources.append("MacScrollMonitor.mm")


    
Import("env")
l1 = env.StaticLibrary("gag", libgag_sources)

if env.get('role') != 'relay':
    Default(l1)

    
Import("env")
Import("PackTar")
import os
    
if 'dist' in COMMAND_LINE_TARGETS or 'install' in COMMAND_LINE_TARGETS:
    for file in os.listdir("."):
        if file.endswith((".cpp", ".mm", ".h")):
            PackTar(env["TARFILE"], file)
    
    PackTar(env["TARFILE"], "SConscript")
