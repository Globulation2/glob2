from sources import GAG_SOURCES
libgag_sources = list(GAG_SOURCES)

from sources import GAG_SERVER_SOURCES
libgag_just_server = list(GAG_SERVER_SOURCES)

    
Import("env")
l1 = env.StaticLibrary("gag", libgag_sources)

l2 = env.StaticLibrary("gag_server", libgag_just_server)


if not env['server']:
    Default(l1)
elif env.get('role') != 'relay':
    Default(l2)

    
Import("env")
Import("PackTar")
import os
    
if 'dist' in COMMAND_LINE_TARGETS or 'install' in COMMAND_LINE_TARGETS:
    for file in os.listdir("."):
        if file.find(".cpp") != -1:
            PackTar(env["TARFILE"], file)
    
    PackTar(env["TARFILE"], "SConscript")
