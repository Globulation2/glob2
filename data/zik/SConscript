import os
    
Import("env")
Import("PackTar")
    
if 'dist' in COMMAND_LINE_TARGETS or 'install' in COMMAND_LINE_TARGETS:
    for file in os.listdir("."):
        if file.find(".ogg") != -1:
            PackTar(env["TARFILE"], file)
            env.Install(env["INSTALLDIR"]+"/glob2/data/zik", file)
    
    
    PackTar(env["TARFILE"], "SConscript")
    env.Alias("install", env["INSTALLDIR"]+"/glob2/data/zik")

# Every soundtrack set is a directory of a1/a2/a3.ogg (calm/building/combat).
# Sets other than "original" are built by tools/music; see docs/assets/music-pipeline.md.

for music_set in ("original", "apple-cider", "bramble-jig", "curious-critters", "fennel-mist", "glass-garden", "moss-lanterns", "orchestral-dawn", "thistle-waltz", "woodland"):
    SConscript(music_set + "/SConscript")
