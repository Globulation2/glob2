import os
    
Import('env')
Import("PackTar")

# Install CLI support before the optimized asset path returns.
if 'install' in COMMAND_LINE_TARGETS and not env.get('server'):
    for source, destination in [('completions/glob2.bash', 'bash-completion/completions/glob2'),
                                ('completions/_glob2', 'zsh/site-functions/_glob2'),
                                ('completions/glob2.fish', 'fish/vendor_completions.d/glob2.fish')]:
        env.Alias('install', env.InstallAs(env['INSTALLDIR'] + '/' + destination, source))
    env.Alias('install', env.Install(env['INSTALLDIR'] + '/man/man6', '#debian/glob2.6'))
if 'dist' in COMMAND_LINE_TARGETS:
    PackTar(env['TARFILE'], Split('completions/glob2.bash completions/_glob2 completions/glob2.fish'))

if env.get('OPTIMIZED_ASSET_INSTALL') and 'dist' not in COMMAND_LINE_TARGETS:
    env.InstallAs(env["INSTALLDIR"] + "/applications/org.globulation2.Globulation2.desktop", "glob2.desktop")
    env.Install(env["INSTALLDIR"] + "/metainfo", "org.globulation2.Globulation2.metainfo.xml")
    env.Alias("install", env["INSTALLDIR"] + "/applications")
    env.Alias("install", env["INSTALLDIR"] + "/metainfo")
    for size in (16, 24, 32, 48, 64, 128, 256):
        icon = env.InstallAs(env['INSTALLDIR'] + '/icons/hicolor/%dx%d/apps/glob2.png' % (size, size),
                             'icons/glob2-icon-%dx%d.png' % (size, size))
        env.Alias('install', icon)
    Return()

    
if 'dist' in COMMAND_LINE_TARGETS or 'install' in COMMAND_LINE_TARGETS:
    for file in sorted(os.listdir(env.Dir(".").srcnode().abspath)):
        if file.endswith(".txt") or file == "rulesets.json":
            PackTar(env["TARFILE"], file)
            env.Install(env["INSTALLDIR"] + "/glob2/data", file)
        
    
    env.InstallAs(env["INSTALLDIR"] + "/applications/org.globulation2.Globulation2.desktop", "glob2.desktop")
    env.Install(env["INSTALLDIR"] + "/metainfo", "org.globulation2.Globulation2.metainfo.xml")
    env.Alias("install", env["INSTALLDIR"]+"/glob2/data")
    env.Alias("install", env["INSTALLDIR"]+"/applications")
    env.Alias("install", env["INSTALLDIR"]+"/metainfo")
    PackTar(env["TARFILE"], "glob2.desktop")
    PackTar(env["TARFILE"], "org.globulation2.Globulation2.metainfo.xml")
    PackTar(env["TARFILE"], "SConscript")
    
SConscript("maxima/SConscript")
SConscript("buildings/SConscript")
SConscript("fonts/SConscript")
SConscript("gfx/SConscript")
SConscript("skins/SConscript")
SConscript("gui/SConscript")
SConscript("themes/SConscript")
SConscript("icons/SConscript")
SConscript("zik/SConscript")
    

SConscript("highres/SConscript")
SConscript("menu/SConscript")
SConscript("usl/SConscript")
