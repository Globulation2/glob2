# Maxima strategy-director schema v2 defaults.
#
# Newly exposed assignments preserve the literal they replaced. Existing
# strategy values retain their configured baseline, including separately
# validated promotions. Schema descriptions and impact tiers explain behavioral
# effect; hard and recommended search bounds define validation and exploration.

# Capacity model: expected service throughput used when computing food headroom.
model.inn_capacity_level1 = 19
model.inn_capacity_level2 = 25
model.inn_capacity_level3 = 34

# Staffing: direct worker reservations for completed buildings, active
# construction, and resource-clearing flags.
# Staffing control: each inn and swarm keeps its own wheat stock inside a band
# by adding or returning one carrier at a time. It never asks for more while it
# is not receiving what it already asked for, because then the workforce, not
# the request, is the constraint.
# The cooldown, not a long window, is what keeps this from oscillating: a
# carrier needs a few passes to show up in the stock, so corrections are spaced
# rather than averaged into sluggishness. At the 200-tick building cadence the
# window spans about 1600 ticks and changes are at least 600 ticks apart.
staffing.control_window_samples = 8
staffing.control_low_permille = 333
staffing.control_high_permille = 667
staffing.control_slack = 1
staffing.control_minimum_workers = 1
staffing.control_maximum_workers = 20
staffing.control_cooldown_passes = 3
staffing.new_inn_workers = 4
staffing.new_swarm_workers = 8
staffing.swarm_supply_radius = 12
staffing.construction_inn_workers = 2
staffing.construction_swarm_workers = 2
staffing.construction_training_workers = 4
staffing.construction_hospital_workers = 3
staffing.construction_large_workers = 6
staffing.completed_tower_workers = 2
staffing.completed_tower_emergency_workers = 4
staffing.clearing_workers = 1
staffing.attack_clearing_workers = 10

