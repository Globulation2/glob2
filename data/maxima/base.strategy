# Food ledger: protected farm capacity claimed by inns and swarms. Supply counts
# only protected wheat cells that currently carry wheat, because that is the
# capacity a settlement keeps at equilibrium. ticks_per_meal is measured from
# real games rather than derived, because hunger drains per unit action and not
# per tick; see doc/MaximaFoodLedger.md. growth_period_ticks is still derived
# from the growth rule alone and remains worth calibrating.
food.enabled = true
food.retirement_enabled = true
food.target_capping_enabled = true
food.growth_period_ticks = 186
food.ticks_per_meal = 11759
food.inn_demand_percent = 100
food.swarm_demand_percent = 100
food.placement_margin_percent = 120
food.quality_band_tiles = 2
food.unreachable_penalty_tiles = 8
food.inn_burden_coverage_percent = 60
food.swarm_burden_coverage_percent = 60
food.recovered_coverage_percent = 85
food.burden_confirm_ticks = 3000
food.retirement_cooldown_ticks = 3000
food.relocation_enabled = true
food.relocation_min_quality_tiles = 5
food.relocation_min_gain_tiles = 3
food.relocation_min_coverage_gain_percent = 25
food.relocation_confirm_ticks = 3000
food.relocation_cooldown_ticks = 6000
food.relocation_offer_ticks = 3000
food.relocation_payback_horizon_ticks = 15000
food.relocation_cost_margin_percent = 125
food.carrier_ticks_per_tile = 23
food.carrier_fixed_ticks_per_trip = 105
food.builder_ticks_per_step = 32
food.relocation_distance_realisation_percent = 155

