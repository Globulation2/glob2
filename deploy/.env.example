# Copy to deploy/.env (ignored by git) and adjust. Docker Compose reads it for
# deploy/compose.yaml; platform-api also receives it as its environment, so the
# provider secrets named in instance.yaml go here too.
# Guide: docs/hosting/README.md.

# ---------------------------------------------------------------- public address
# The domain Caddy serves and obtains certificates for, and the origin players
# use (include the port when it is not 443).
GLOB2_DOMAIN=localhost
# Optional second served hostname during a domain cutover; unlike redirect names,
# this serves the same app and API. It does not change PUBLIC_ORIGIN.
# GLOB2_ADDITIONAL_DOMAIN=app.glob2online.com
GLOB2_PUBLIC_ORIGIN=https://localhost:8443
# Other names that redirect there, comma-separated (each needs DNS and gets its
# own certificate), e.g. www.play.example.org.
# GLOB2_REDIRECT_DOMAINS=
# Optional: a public website hosted elsewhere (e.g. the apex beside an app.
# subdomain) and its download page, linked from the web app. Build-time: rebuild
# the caddy image after changing them.
# GLOB2_WEBSITE_URL=https://example.org/
# GLOB2_DOWNLOAD_URL=https://example.org/downloads/
# Host address and ports Caddy publishes. Public server: 0.0.0.0, 80, 443.
GLOB2_BIND=127.0.0.1
GLOB2_HTTP_PORT=8080
GLOB2_HTTPS_PORT=8443
# auto: ACME certificates for a public domain, Caddy's local CA for localhost.
# internal: always Caddy's local CA (LAN names, staging).
GLOB2_TLS_MODE=auto
# CIDRs of a load balancer in front of Caddy whose X-Forwarded-For is trusted.
# GLOB2_EDGE_TRUSTED_PROXIES=127.0.0.1/32

# ---------------------------------------------------------------- database
# Letters and digits only (it is embedded in a connection URL), e.g.
#   openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------- scaling
GLOB2_API_REPLICAS=2
GLOB2_WORKER_REPLICAS=1
GLOB2_ENGINE_AGENT_REPLICAS=1
GLOB2_RELAY_REPLICAS=1
# Engine jobs each agent runs at once, and its scratch space.
ENGINE_CONCURRENCY=1
# GLOB2_ENGINE_SCRATCH_SIZE=1g

# ---------------------------------------------------------------- relays
# Region reported by this host's relays (lowercase id, e.g. eu-west).
GLOB2_RELAY_REGION=default
# GLOB2_RELAY_MAX_MATCHES=200
# Longest drain on stop; keep GLOB2_RELAY_STOP_GRACE above it.
# GLOB2_RELAY_DRAIN_SECONDS=1800
# GLOB2_RELAY_STOP_GRACE=31m

# ---------------------------------------------------------------- signing keys
# Generated into the signing-keys volume on first start. During a rotation,
# set the key id that signs new tokens (see the hosting guide).
# JWT_ACTIVE_KID=k20261001

# ---------------------------------------------------------------- images
# Local builds by default. For releases, pin digests.
# GLOB2_MUSIC_IMAGE=ghcr.io/OWNER/REPOSITORY-music-worker@sha256:...
# GLOB2_PLATFORM_IMAGE=ghcr.io/OWNER/REPOSITORY-platform@sha256:...
# GLOB2_ENGINE_AGENT_IMAGE=ghcr.io/OWNER/REPOSITORY-engine-agent:simver-125-49-...
# GLOB2_RELAY_IMAGE=ghcr.io/OWNER/REPOSITORY-relay@sha256:...
# GLOB2_CADDY_IMAGE=ghcr.io/OWNER/REPOSITORY-caddy@sha256:...
# Sim version label for local engine-agent builds:
#   GLOB2_SIM_VERSION=$(python3 deploy/sim_version.py)
# GLOB2_SIM_VERSION=
# GLOB2_BUILD_JOBS=4

# ---------------------------------------------------------------- files
# Packaged WebAssembly client served at /play/ (scons target=web release=1,
# then python3 browser/package-static.py).
# GLOB2_WEB_CLIENT_DIR=../build/browser-static
# GLOB2_INSTANCE_CONFIG=./instance.yaml

# ---------------------------------------------------------------- limits
# Largest map or save upload, and largest match record a relay may upload.
# UPLOAD_MAX_BYTES=16777216
# RECORD_MAX_BYTES=67108864
# Extra relay keys (relays on other hosts), comma-separated `<relayId>:<key>`.
# RELAY_KEYS=

# ---------------------------------------------------------------- misc
LOG_LEVEL=info
# Private backend network; change both together if the subnet is taken.
# GLOB2_BACKEND_SUBNET=172.30.89.0/24
# GLOB2_PROXY_ADDRESS=172.30.89.10

# ---------------------------------------------------------------- provider secrets
# Named by instance.yaml (`clientSecretEnv`, `privateKeyEnv`).
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_SECRET=
# APPLE_SIGNIN_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Optional AI Map Studio; credentials stay separate from Hive Mind.
MAP_OPENAI_API_KEY=
MAP_STRIPE_SECRET_KEY=
MAP_STRIPE_WEBHOOK_SECRET=

# CPU Music Studio (optional ai-music profile)
MUSIC_OPENAI_API_KEY=
MUSIC_STRIPE_SECRET_KEY=
MUSIC_STRIPE_WEBHOOK_SECRET=
# Optional AI coding Studio; enable aiStudio in instance.yaml only after validation.
AI_STUDIO_OPENAI_API_KEY=
AI_STUDIO_STRIPE_SECRET_KEY=
AI_STUDIO_STRIPE_WEBHOOK_SECRET=
