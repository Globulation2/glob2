# Daily database backup to Google Cloud Storage (deploy/backup-to-gcs.sh).
# Installed by deploy/install-backup-timer.sh, which fills in @USER@, @SOURCE@
# and @ENV_FILE@; see docs/hosting/backups.md.
[Unit]
Description=Globulation 2 platform database backup to Cloud Storage
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@SOURCE@
# flock: a slow run never overlaps the next one.
ExecStart=/usr/bin/flock --nonblock @SOURCE@/../backup.lock @SOURCE@/deploy/backup-to-gcs.sh @ENV_FILE@
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h
