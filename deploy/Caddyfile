# Public edge of the platform stack (deploy/compose.yaml). See docs/hosting/README.md.
#
#   /api/*, /realtime, /signin, /auth/*, /.well-known/*   platform-api (any replica)
#   /relay/<relay id>                                      that relay's match WebSocket
#   /play/*                                                WebAssembly client (mounted at /srv/play)
#   everything else                                        apps/web (invite links /j/<code> included)
#   /internal/*, /healthz, /readyz, /metrics               never served publicly
(tls-auto) {
}
(tls-internal) {
	tls internal
}

{
	servers {
		trusted_proxies static {$GLOB2_EDGE_TRUSTED_PROXIES:127.0.0.1/32}
		trusted_proxies_strict
	}
}

{$GLOB2_DOMAIN:localhost} {
	# auto: public certificates via ACME for a real domain, Caddy's local CA for
	# localhost; internal: always the local CA (LAN host names, staging).
	import tls-{$GLOB2_TLS_MODE:auto}
	encode zstd gzip

	@private path /internal /internal/* /healthz /readyz /metrics
	respond @private 404

	# Each relay registers wss://<domain>/relay/<relay id>; the id is its
	# container name on the backend network. Only single-label names (no dots)
	# match, so this cannot proxy to arbitrary hosts.
	@relay path_regexp relay ^/relay/([a-z0-9][a-z0-9-]{0,62})$
	handle @relay {
		rewrite * /relay
		reverse_proxy {re.relay.1}:7495 {
			header_up X-Forwarded-For {client_ip}
			# Keep matches open across Caddy config reloads.
			stream_close_delay 5m
		}
	}

	@platform path /api/* /realtime /signin /signin/* /auth/* /.well-known/*
	handle @platform {
		# Every platform-api replica, re-resolved as replicas come and go.
		reverse_proxy {
			dynamic a {
				name platform-api
				port 8080
				refresh 5s
			}
			header_up X-Forwarded-For {client_ip}
			lb_policy round_robin
			lb_try_duration 5s
			fail_duration 10s
			stream_close_delay 5m
		}
	}

	redir /play /play/
	handle_path /play/* {
		root * /srv/play
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		root * /srv/web
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

http://127.0.0.1:2015 {
	respond /livez 200
}
