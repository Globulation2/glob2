# Public edge of the platform stack (deploy/compose.yaml). See docs/hosting/README.md.
#
#   /api/*, /realtime, /signin, /auth/*, /.well-known/*,
#   /j/<code> (invite pages)                               platform-api (any replica)
#   /relay/<relay host name>                               that relay's match WebSocket
#   /play/*                                                WebAssembly client (mounted at /srv/play)
#   everything else                                        apps/web
#   /internal/*, /healthz, /readyz, /metrics               never served publicly
#
# Security headers: HSTS, nosniff and a Referrer-Policy everywhere; a
# Content-Security-Policy with frame-ancestors 'none' for the web app, the
# WebAssembly client and the API, except the same-origin Studio frame. Pages the
# API renders itself, such as /signin and /j/<code>, keep their stricter policy:
# `?` only fills a header the response does not already have.
(tls-auto) {
}
(tls-internal) {
	tls internal
}

{
	servers {
		trusted_proxies static {$GLOB2_EDGE_TRUSTED_PROXIES:127.0.0.1/32}
		trusted_proxies_strict
	}
}

{$GLOB2_DOMAIN:localhost} {$GLOB2_ADDITIONAL_DOMAIN:} {
	# auto: public certificates via ACME for a real domain, Caddy's local CA for
	# localhost; internal: always the local CA (LAN host names, staging).
	import tls-{$GLOB2_TLS_MODE:auto}
	encode zstd gzip

	header {
		# HTTPS only for this name from now on (GLOB2_HSTS_MAX_AGE=0 turns it off).
		Strict-Transport-Security "max-age={$GLOB2_HSTS_MAX_AGE:31536000}"
		X-Content-Type-Options nosniff
		?Referrer-Policy strict-origin-when-cross-origin
		# Studio explicitly allows same-origin framing; admin/account pages remain protected.
		?X-Frame-Options DENY
		-Server
	}

	# First: `handle` blocks are exclusive and run before a bare `respond`.
	@private path /internal /internal/* /healthz /readyz /metrics
	handle @private {
		respond 404
	}

	# Each relay registers wss://<domain>/relay/<host name>; the label is its
	# container host name on the backend network (the relay id is separate:
	# relay-<n>, deploy/relay-entrypoint.sh). Only single-label names (no dots)
	# match, so this cannot proxy to arbitrary hosts.
	@relay path_regexp relay ^/relay/([a-z0-9][a-z0-9-]{0,62})$
	handle @relay {
		rewrite * /relay
		reverse_proxy {re.relay.1}:7495 {
			header_up X-Forwarded-For {client_ip}
			# Keep matches open across Caddy config reloads.
			stream_close_delay 5m
		}
	}

	@platform path /api/* /realtime /signin /signin/* /auth/* /.well-known/* /j/*
	handle @platform {
		# JSON and files: nothing to run, nothing to frame.
		header ?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		# Every platform-api replica, re-resolved as replicas come and go.
		reverse_proxy {
			dynamic a {
				name platform-api
				port 8080
				refresh 5s
			}
			header_up X-Forwarded-For {client_ip}
			lb_policy round_robin
			lb_try_duration 5s
			fail_duration 10s
			stream_close_delay 5m
		}
	}

	redir /play /play/
	handle_path /play/* {
		root * /srv/play
		# Data packages are named by their content (scons/web_assets.py) and never
		# change; everything else revalidates so a new release is picked up at once.
		@immutable path_regexp ^/assets/[a-z0-9-]+\.[0-9a-f]{16}\.data$
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@revalidate not path_regexp ^/assets/[a-z0-9-]+\.[0-9a-f]{16}\.data$
		header @revalidate Cache-Control "no-cache"
		header Cross-Origin-Opener-Policy "same-origin"
		header Cross-Origin-Embedder-Policy "require-corp"
		# The client: an inline loader in index.html (browser/shell.html), the
		# WebAssembly runtime ('wasm-unsafe-eval'), pthread and probe workers
		# (blob:), and connections to whichever instance and relays the player
		# chooses (https:, wss:).
		@standardPlay not path /studio.html
		header @standardPlay Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https: wss:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		@studioEmbed path /studio.html
		header @studioEmbed X-Frame-Options "SAMEORIGIN"
		header @studioEmbed Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
		# Serve the Brotli or gzip copy written at build time (browser/precompress.py)
		# when the browser accepts it. This rewrites to the copy instead of using
		# file_server's `precompressed`, which in Caddy 2.10 answers plain requests
		# with 206 Partial Content that browsers then neither cache nor revalidate.
		header Vary Accept-Encoding
		@html path / *.html
		header @html Content-Type "text/html; charset=utf-8"
		@js path *.js
		header @js Content-Type "text/javascript; charset=utf-8"
		@wasm path *.wasm
		header @wasm Content-Type application/wasm
		@data path *.data
		header @data Content-Type application/octet-stream
		@brotli {
			header Accept-Encoding *br*
			file {path}.br
		}
		@gzip {
			not header Accept-Encoding *br*
			header Accept-Encoding *gzip*
			file {path}.gz
		}
		header @brotli Content-Encoding br
		header @gzip Content-Encoding gzip
		rewrite @brotli {path}.br
		rewrite @gzip {path}.gz
		file_server
	}

	handle {
		root * /srv/web
		# The web app: its own scripts, styles and fonts; data from this origin.
		@webApp not path /music/decode-worker.js
		header @webApp Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src 'self'; media-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		# The dedicated music worker compiles the Opus decoder. Permit WebAssembly
		# compilation here while keeping JavaScript eval blocked everywhere.
		@musicDecoder path /music/decode-worker.js
		header @musicDecoder Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src 'self'; media-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		@aiStudio path /ai-studio /ai-studio/*
		header @aiStudio Cross-Origin-Opener-Policy "same-origin"
		header @aiStudio Cross-Origin-Embedder-Policy "require-corp"
		# Dedicated Monaco workers inherit the isolated Studio document policy.
		@studioWorkers path_regexp ^/assets/(editor|ts)\.worker-[^/]+\.js$
		header @studioWorkers Cross-Origin-Embedder-Policy "require-corp"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

# Extra names (e.g. www.<domain>) that redirect to the instance's domain, with
# their own certificates. Unset: a placeholder that is never served.
{$GLOB2_REDIRECT_DOMAINS:http://redirect.invalid} {
	redir https://{$GLOB2_DOMAIN:localhost}{uri} permanent
}

http://127.0.0.1:2015 {
	respond /livez 200
}
