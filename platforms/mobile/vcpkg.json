{
  "name": "glob2-mobile",
  "version": "0.9.5",
  "builtin-baseline": "80d54ff62d528339c626a6fbc3489a7f25956ade",
  "dependencies": [
    {
      "name": "sdl3",
      "default-features": false,
      "features": [
        {
          "name": "vulkan",
          "platform": "android"
        }
      ]
    },
    {
      "name": "sdl3-image",
      "default-features": false,
      "features": [
        "jpeg",
        "png",
        "webp"
      ]
    },
    {
      "name": "sdl3-ttf",
      "default-features": false,
      "features": ["harfbuzz"]
    },
    "sdl3-net",
    {
      "name": "opusfile",
      "default-features": false
    },
    "zlib",
    "boost-date-time",
    "boost-asio",
    "boost-logic",
    "boost-lambda",
    "boost-random",
    "boost-math",
    "openssl",
    "boost-beast"
  ],
  "features": {
    "crash-capture": {
      "description": "Crashpad for Android builds that send crash reports (docs/multiplayer/crash-reports.md)",
      "dependencies": [
        {
          "name": "crashpad",
          "platform": "android"
        }
      ]
    }
  },
  "vcpkg-configuration": {
    "overlay-ports": [
      "../../buildsys/vcpkg-ports"
    ]
  }
}
