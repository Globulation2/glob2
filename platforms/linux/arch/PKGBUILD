pkgname=glob2
pkgver=0.11.7.0
pkgrel=1
pkgdesc='Real-time strategy game with automatic unit task assignment'
arch=('x86_64')
url='https://globulation2.org/'
license=('GPL-3.0-or-later')
depends=('ffmpeg' 'fribidi' 'glibc' 'glu' 'libepoxy' 'libglvnd' 'libogg' 'libstdc++'
         'libwebp' 'openssl' 'opus' 'opusfile' 'sdl3' 'sdl3_image' 'sdl3_net' 'sdl3_ttf'
         'speex' 'zlib')
makedepends=('boost' 'cmake' 'libjpeg-turbo' 'ninja' 'pkgconf' 'python' 'python-pip' 'python-wheel')
source=("https://github.com/Globulation2/glob2/releases/download/v${pkgver}/glob2-${pkgver}.tar.gz"
        'system-ffmpeg.patch'
        'https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-1.6.0.tar.gz'
        'https://files.pythonhosted.org/packages/18/5d/3bf57dcd21979b887f014ea83c24ae194cfcd12b9e0fda66b957c69d1fca/setuptools-80.9.0.tar.gz'
        'https://files.pythonhosted.org/packages/a5/98/9118a0659646f1628c592ef9bb48e0056efa6bf27c951fd12a178e0136fb/pybind11-3.0.2.tar.gz'
        'https://files.pythonhosted.org/packages/8c/21/c2bcdd5906101a30244eaffc1b6e6ce71a31bd0742a01eb89e660ebfac2d/pillow-12.2.0.tar.gz')
noextract=('libwebp-1.6.0.tar.gz' 'setuptools-80.9.0.tar.gz' 'pybind11-3.0.2.tar.gz' 'pillow-12.2.0.tar.gz')
sha256sums=('3dffe97a657a8025e48990e7f9581a2108ab81c5c67f8e54fa2b09052a20b5d6'
            'be5f1f6cadb2387b5de256243334e1bc6b4b9a6325e85732a0e7f3ae0f352a06'
            'e4ab7009bf0629fd11982d4c2aa83964cf244cffba7347ecd39019a9e38c4564'
            'f36b47402ecde768dbfafc46e8e4207b4360c654f1f3bb84475f0a28628fb19c'
            '432f01aeb68e361a3a7fc7575c2c7f497595bf640f747acd909ff238dd766e06'
            'a830b1a40919539d07806aa58e1b114df53ddd43213d9c8b75847eee6c0182b5')

prepare() {
  cd "$pkgname-$pkgver"
  patch -Np1 < "$srcdir/system-ffmpeg.patch"
}

build() {
  python "$pkgname-$pkgver/tools/build_asset_encoder.py" build \
    --sources "$srcdir" --output "$srcdir/asset-encoder"
  export GLOB2_ASSET_ENCODER_PYTHON="$srcdir/asset-encoder/venv/bin/python"
  cmake -S "$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DGLOB2_BUILD_ARGS='release=1 retain_symbols=1 optimized_assets=0 sprite_packing=legacy recording_codec=vp9' \
    -DGLOB2_CXXFLAGS="$CXXFLAGS" \
    -DGLOB2_LINKFLAGS="$LDFLAGS" \
    -DGLOB2_SHIPPING=ON \
    -DGLOB2_SYSTEM_FFMPEG=ON
  cmake --build build --target glob2
}

package() {
  export GLOB2_ASSET_ENCODER_PYTHON="$srcdir/asset-encoder/venv/bin/python"
  DESTDIR="$pkgdir" cmake --install build
}
