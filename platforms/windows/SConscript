"""Source archive contents; Windows installers use the shared runtime stage."""
from pathlib import Path
import tempfile

Import('env', 'PackTar', 'isWindowsPlatform')

if 'dist' in COMMAND_LINE_TARGETS or 'install' in COMMAND_LINE_TARGETS:
    PackTar(env['TARFILE'], ['glob2.ico', 'header.bmp', 'side.bmp',
                            'win32_installer.nsi', 'SConscript'])

if 'windows-installer' in COMMAND_LINE_TARGETS:
    if not (isWindowsPlatform or env['mingw']):
        raise ValueError('windows-installer requires a native MinGW build')
    from tools.package_assets import source_files
    from tools.release.package_windows import stage
    from tools.release.package_nsis import package

    def installer(target, source, env):
        with tempfile.TemporaryDirectory(prefix='glob2-installer-') as temporary:
            runtime = stage(Path(source[0].abspath), Path(temporary) / 'runtime')
            package(runtime, Path(target[0].abspath), env['VERSION'])
        return 0

    binary = env.File('#' + env['BUILDDIR'] + '/src/glob2.exe')
    inputs = [binary] + [env.File('#' + str(path.relative_to(Path.cwd())))
                         for path in source_files(Path.cwd(), 'windows')]
    inputs += [env.File('#' + path) for path in
               ('COPYING', 'docs/assets/source-attribution.md',
                'tools/release/windows_runtime.py', 'tools/release/package_windows.py',
                'tools/release/package_nsis.py', 'tools/package_assets.py',
                'windows/win32_installer.nsi')]
    output = '#' + env['BUILDDIR'] + '/glob2-' + env['VERSION'] + '-windows-x86_64-setup.exe'
    env.Alias('windows-installer', env.Command(output, inputs, installer))
