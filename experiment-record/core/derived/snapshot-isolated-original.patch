+		for (const auto& bucket : queues) {
+			if (active) {
+				result.logicalEntries += bucket.size;
+				result.storageEntries += bucket.cells.size();
+				result.capacityEntries += bucket.cells.capacity();
+				result.populatedBuckets += bucket.size != 0;
+				result.allocatedBuckets += !bucket.cells.empty();
+			} else {
+				result.inactiveStorageEntries += bucket.cells.size();
+				result.inactiveCapacityEntries += bucket.cells.capacity();
+			}
+		}
+	};
+	account(buckets, !modifiedCosts);
+	if (custom) account(custom->buckets, modifiedCosts);
+	return result;
