+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <atomic>
+#include <cstdint>
+
+namespace gradient_kernel
+{
+// Local device admission only. A permanent failure can never be rehabilitated.
+// Device serializes admission/readiness publication under its failure mutex.
+class OpenCLDeviceHealth
+{
+public:
+    enum class State { Ready, CancellationSuspended, PermanentFailure };
+private:
+    std::atomic<State> value{State::Ready};
+public:
+    State state() const noexcept { return value.load(std::memory_order_acquire); }
+    bool ready() const noexcept { return state()==State::Ready; }
+    bool failed() const noexcept { return state()==State::PermanentFailure; }
+    bool suspended() const noexcept { return state()==State::CancellationSuspended; }
+    void fail() noexcept { value.store(State::PermanentFailure,std::memory_order_release); }
+    void suspend() noexcept {
+        auto expected=State::Ready;
+        value.compare_exchange_strong(expected,State::CancellationSuspended,std::memory_order_acq_rel);
+    }
+    bool recover(bool retainedProofPending,std::uint64_t activeLanes) noexcept {
+        if(retainedProofPending || activeLanes)return false;
+        auto expected=State::CancellationSuspended;
+        return value.compare_exchange_strong(expected,State::Ready,std::memory_order_acq_rel);
+    }
+};
+}
