diff --git a/src/ai/maxima/MaximaFarmingStandaloneTest.cpp b/src/ai/maxima/MaximaFarmingStandaloneTest.cpp
index 9080d9ec2..0d44950de 100644
--- a/src/ai/maxima/MaximaFarmingStandaloneTest.cpp
+++ b/src/ai/maxima/MaximaFarmingStandaloneTest.cpp
@@ -250,10 +250,10 @@ TEST_SUITE("Maxima.Farming")
 		// Keep the same work budget; elapsed time also counts unrelated builds
 		// and other processes that prevent this test from getting CPU time.
 		REQUIRE(cpuMicroseconds>=0);
-		// The release suite enforces the production CPU budget. O0 source
-		// coverage adds counters to every branch, so it records the same work
-		// and verifies its results without comparing instrumented CPU cost.
-#ifndef GLOB2_TEST_COVERAGE
+		// Enforce the production CPU budget only with optimized GCC/Clang
+		// builds. Fast development and source coverage builds still check the
+		// cache results and report timing, but their CPU cost is not comparable.
+#if defined(__OPTIMIZE__) && !defined(GLOB2_TEST_COVERAGE)
 		REQUIRE(cpuMicroseconds<100000);
 #endif
 	}
diff --git a/test/README.md b/test/README.md
index 56dbc806c..0f68546fd 100644
--- a/test/README.md
+++ b/test/README.md
@@ -39,6 +39,10 @@ python3 test/run_tests.py --binary engine --in-process     # fast local loop, no
 python3 test/run_tests.py --update-fixtures --filter 'WinningConditions/*'
 ```
 
+The `Maxima.Farming` fertility-cache case checks correctness in every build and
+enforces its CPU-time budget only in optimized builds without coverage
+instrumentation. Fast development builds report that timing for diagnosis.
+
 `ColonySkinPreview` checks shared image preparation with independent appearance
 authorization, refresh, expiry and cancellation across preview owners.
 
