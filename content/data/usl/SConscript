import os

Import('env', 'PackTar')

if 'dist' in COMMAND_LINE_TARGETS or 'install' in COMMAND_LINE_TARGETS:
    PackTar(env['TARFILE'], 'SConscript')
    for tree in ('Glob2', 'Language'):
        for directory, _, files in os.walk(tree):
            for name in sorted(files):
                if not name.endswith('.usl'):
                    continue
                source = os.path.join(directory, name)
                PackTar(env['TARFILE'], source)
                installed = env.Install(
                    env['INSTALLDIR'] + '/glob2/data/usl/' + directory, source)
                env.Alias('install', installed)
