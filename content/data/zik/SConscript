import os

Import("env")
Import("PackTar")

if 'dist' in COMMAND_LINE_TARGETS or 'install' in COMMAND_LINE_TARGETS:
    # Sets are discovered by directory, so new sets need no build registration.
    source_root = env.Dir(".").srcnode().abspath
    for source_directory, _, files in os.walk(source_root):
        directory = os.path.relpath(source_directory, source_root)
        for name in sorted(files):
            file = os.path.normpath(os.path.join(directory, name))
            if name.endswith(".opus") or name == "LICENSE.txt":
                PackTar(env["TARFILE"], file)
                env.Install(env["INSTALLDIR"] + "/glob2/data/zik/" + directory, file)
            elif name == "SConscript":
                PackTar(env["TARFILE"], file)
    env.Alias("install", env["INSTALLDIR"] + "/glob2/data/zik")
