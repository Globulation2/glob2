Import("env")
Import("PackTar")
    
if 'dist' in COMMAND_LINE_TARGETS or 'install' in COMMAND_LINE_TARGETS:
    PackTar(env["TARFILE"], "sans.ttf")
    env.Install(env["INSTALLDIR"]+"/glob2/data/fonts", "sans.ttf")
    for notice in ["LICENSE-DejaVu.txt", "LICENSE-Droid.txt", "LICENSE-Noto.txt", "LICENSE-HarfBuzz.txt", "README.md"]:
        PackTar(env["TARFILE"], notice)
        env.Install(env["INSTALLDIR"]+"/glob2/data/fonts", notice)
    env.Alias("install", env["INSTALLDIR"]+"/glob2/data/fonts")
    PackTar(env["TARFILE"], "SConscript")
    PackTar(env["TARFILE"], "build_chinese_font.py")
    PackTar(env["TARFILE"], "fetch_script_fonts.py")
    PackTar(env["TARFILE"], "check_script_support.py")
    PackTar(env["TARFILE"], "script-probes.json")
    PackTar(env["TARFILE"], "scripts/manifest.json")
    for font in Glob("scripts/*.ttf"):
        PackTar(env["TARFILE"], font)
        env.Install(env["INSTALLDIR"]+"/glob2/data/fonts/scripts", font)
