from sources import CLIENT_SOURCES
source_files = list(CLIENT_SOURCES)
Import('env')
if env.get('role') == 'relay':
    # The relay role builds glob2-relay and its tests only.
    from sources import RELAY_SOURCES, RELAY_GAG_SOURCES
    relay_env = env.Clone()
    relay_env.Append(CPPPATH=['#src/relay'])
    relay_env['LIBS'] = [lib for lib in relay_env.get('LIBS', []) if lib in ('ssl', 'crypto', 'pthread')]
    relay_objects = [relay_env.Object(source) for source in RELAY_SOURCES]
    relay_objects += [relay_env.Object('relay-gag-' + source.replace('.cpp', '.o'), '#libgag/src/' + source)
                      for source in RELAY_GAG_SOURCES]
    relay = relay_env.Program('glob2-relay', relay_objects + [relay_env.Object('relay/RelayMain.cpp')])
    relay_env.Default(relay)
    relay_env.Alias('relay', relay)
    tests_env = relay_env.Clone()
    tests_env.Append(CPPPATH=['#test/third_party'])
    tests_env.Append(CPPDEFINES=[('RELAY_FIXTURE_DIR', '\\"%s\\"' % Dir('#test/fixtures/relay-tickets').abspath)])
    relay_tests = tests_env.Program('glob2-relay-tests', relay_objects + [
        tests_env.Object('relay-test-' + name + '.o', '#src/relay/' + name + '.cpp')
        for name in ('RelayTestMain', 'RelayTicketTest', 'RelayAdmissionTest')])
    tests_env.Alias('relay-tests', relay_tests)
    tests_env.Alias('relay', relay_tests)
    Return()
if not env.get('wss', True):
    source_files.remove('net/WssTransport.cpp')
    source_files.remove('online/HttpFetch.cpp')
local = env.Clone()
from skin_render import configure as configure_skin_render
configure_skin_render(local)
platform_trust_sources = []
if env['PLATFORM'] in ('darwin', 'win32') or env.get('mingw') or env.get('mingwcross'):
    platform_trust_sources = local.Object('PlatformTrustCore.o', '#mobile/CertificateTrust.cpp')
    platform_trust_sources += local.Object('PlatformTrustPolicy.o', '#mobile/ios/CertificateTrust.cpp' if env['PLATFORM'] == 'darwin' else 'net/WindowsCertificateTrust.cpp')
source_files += platform_trust_sources
js_library = SConscript('#third_party/SConscript', variant_dir=Dir('#' + env['BUILDDIR'] + '/third_party'), duplicate=0, exports={'env': env})
local.Append(CPPPATH=['#third_party/quickjs-ng'])
source_files += [node.abspath for node in js_library]

# Host numeric conversion must use the same strict boundary as the interpreter.
strict = local.Clone()
strict.Append(CXXFLAGS=['-fno-fast-math', '-ffp-contract=off'])
strict_sources = [source for source in source_files
                  if isinstance(source, str) and source.endswith('.cpp') and (source.startswith('scripting/javascript/') or source == 'ai/javascript/AIJavaScript.cpp')]
from javascript import numeric_guard
strict_objects = dict(zip(strict_sources, [strict.Object(source)[0] for source in strict_sources]))
numeric_guard(strict, list(strict_objects.values()))
# Resolve these sources explicitly so Program does not compile them with generic flags.
program_sources = [strict_objects.get(source, source) for source in source_files]

#Add libgag and USL, not as a library, but as an object
source_files.append("../libgag/src/libgag.a")
source_files.append("../libusl/src/libusl.a")
p1 = local.Program("glob2", program_sources + ["../libgag/src/libgag.a", "../libusl/src/libusl.a"])
if env.get("RUNTIME_ASSET_STAMP"):
    local.Depends(p1, env["RUNTIME_ASSET_STAMP"])

# Shared with test/SConscript: every client object except the entry point, so test
# binaries link exactly the objects the game was built from and nothing compiles twice.
client_cpp_sources = [source for source in source_files if isinstance(source, str) and source != 'app/Glob2.cpp' and source.endswith('.cpp')]
client_objects = [strict_objects[source] if source in strict_objects else local.Object(source)[0]
                  for source in client_cpp_sources]
client_object_by_source = dict(zip(client_cpp_sources, client_objects))
client_objects += platform_trust_sources
client_libs = [local.File(source) for source in source_files if isinstance(source, str) and not source.endswith('.cpp')]
Export('client_objects', 'client_object_by_source', 'client_libs')


lan_sources = [strict_objects.get(source, source) for source in source_files if source != 'app/Glob2.cpp']
lan_sources += local.Object('LANSessionHarness.o', '#src/net/lan/LANSessionHarness.cpp')
lan_test = local.Program('LANSessionHarness', lan_sources)
local.Alias('lan-test', lan_test)
online_play_test = local.Program('OnlinePlayHarness', [strict_objects.get(source, source) for source in source_files if source != 'app/Glob2.cpp']
                                 # It reads the engine's game state to report what it sees.
                                 + local.Object('OnlinePlayHarness.o', '#src/online/OnlinePlayHarness.cpp',
                                                CXXFLAGS=local['CXXFLAGS'] + ['-fno-access-control']))
local.Alias('online-play-test', online_play_test)

# Twelve-team sprite benchmark; not part of the default build.
twelve_team_benchmark = local.Program('twelve-team-benchmark',
    local.Object('TwelveTeamBenchmark.o', '#tools/unit-animation/twelve-team-benchmark.cpp')
    + ['../libgag/src/libgag.a', '../libusl/src/libusl.a'])
local.Alias('twelve-team-benchmark', twelve_team_benchmark)

# Map analysis tools and the golden test use production generators and widgets.
for alias, target in [('map-generator-study', 'MapGeneratorStudy'),
                      ('map-generator-golden-test', 'MapGeneratorGoldenTest'),
                      ('map-generator-profile-fixture', 'MapGeneratorProfileFixture')]:
    sources = [strict_objects.get(source, source) for source in source_files if source != 'app/Glob2.cpp']
    sources += local.Object(target + '.o', '#src/map/generator/' + target + '.cpp')
    local.Alias(alias, local.Program(target, sources))
transport_sources = [strict_objects.get(source, source) for source in source_files if source != 'app/Glob2.cpp']
transport_sources += local.Object('NetConnectionHarness.o', '#src/net/NetConnectionHarness.cpp')
transport_test = local.Program('net-connection-test', transport_sources)
local.Alias('transport-test', transport_test)
discovery_test = local.Program('lan-discovery-test', [
    'net/NetBroadcastListener.cpp', 'net/NetBroadcaster.cpp', 'net/NetworkConfig.cpp', 'net/LanIdentity.cpp',
    local.Object('LANDiscoveryHarness.o', '#src/net/LANDiscoveryHarness.cpp')])
local.Alias('transport-test', discovery_test)
if env.get('wss', True):
    wss_test = local.Program('wss-transport-test', [
        'net/NetTransport.cpp', 'net/TcpTransport.cpp', 'net/WssTransport.cpp', 'net/NetworkConfig.cpp', 'net/LanIdentity.cpp',
        local.Object('WssTransportHarness.o', '#src/net/WssTransportHarness.cpp')] + platform_trust_sources)
    local.Alias('transport-test', wss_test)
    listener_test = local.Program('wss-listener-test', [
        'net/NetTransport.cpp', 'net/TcpTransport.cpp', 'net/WssTransport.cpp', 'net/NetworkConfig.cpp', 'net/LanIdentity.cpp',
        local.Object('WssListenerHarness.o', '#src/net/WssListenerHarness.cpp')] + platform_trust_sources)
    local.Alias('transport-test', listener_test)
    http_test = local.Program('http-fetch-test', [
        'online/HttpFetch.cpp', 'online/HttpFetchCommon.cpp',
        local.Object('HttpFetchHarness.o', '#src/online/HttpFetchHarness.cpp')] + platform_trust_sources)
    local.Alias('transport-test', http_test)
    probe_file_manager = local.Object('OnlineProbeFileManager.o', '#src/online/OnlineProbeFileManager.cpp')
    platform_probe = local.Program('platform-client-probe', [
        'online/HttpFetch.cpp', 'online/HttpFetchCommon.cpp', 'online/InstanceConfig.cpp',
        'online/MemoryStorage.cpp', 'online/PlatformClient.cpp', 'online/PlatformProtocol.cpp',
        'online/SimVersion.cpp', 'online/Sha256.cpp',
        'net/NetTransport.cpp', 'net/TcpTransport.cpp', 'net/WssTransport.cpp', 'net/NetworkConfig.cpp', 'net/LanIdentity.cpp',
        local.Object('PlatformClientProbe.o', '#src/online/PlatformClientProbe.cpp')] + probe_file_manager + platform_trust_sources)
    local.Alias('transport-test', platform_probe)
    screens_probe = local.Program('online-screens-probe', [
        'online/HttpFetch.cpp', 'online/HttpFetchCommon.cpp', 'online/InstanceConfig.cpp',
        'online/MemoryStorage.cpp', 'online/PlatformClient.cpp', 'online/PlatformProtocol.cpp',
        'online/OnlineResources.cpp', 'online/QuickMatch.cpp', 'online/RelayProbe.cpp',
        'online/MapCatalog.cpp', 'online/SimVersion.cpp', 'online/Sha256.cpp',
        'net/NetTransport.cpp', 'net/TcpTransport.cpp', 'net/WssTransport.cpp', 'net/NetworkConfig.cpp', 'net/LanIdentity.cpp',
        local.Object('OnlineScreensProbe.o', '#src/online/OnlineScreensProbe.cpp')] + probe_file_manager + platform_trust_sources)
    local.Alias('online-screens-probe', screens_probe)

local.Default(p1)

Import('env')
Import("PackTar")

if 'dist' in COMMAND_LINE_TARGETS or 'install' in COMMAND_LINE_TARGETS:
    env.Install(env["BINDIR"], "glob2")
    env.Alias("install", env["BINDIR"])

    import os
    for directory, _, names in os.walk("."):
        for file in names:
            if file.find(".cpp") != -1 or file.find(".h") != -1 or file.find(".py") != -1:
                PackTar(env["TARFILE"], os.path.join(directory, file))

    PackTar(env["TARFILE"], "SConscript")

# Offline production-screen capture for the mobile design review gallery.
gallery_sources = [strict_objects.get(source, source) for source in source_files if source != 'app/Glob2.cpp']
gallery_sources += local.Object('MobileGalleryHarness.o', '#tools/MobileGalleryHarness.cpp')
local.Alias('mobile-gallery', local.Program('mobile-gallery', gallery_sources))

# Original-derived skin comparison and full game render diagnostics.
skin_preview = local.Program('skin-preview',
    local.Object('SkinPreview.o', '#tools/skins/preview.cpp')
    + ['../libgag/src/libgag.a', '../libusl/src/libusl.a'])
local.Alias('skin-preview', skin_preview)
# Diagnostic harness inspects view-owned appearance, as engine render tests do.
skin_game_env = local.Clone()
skin_game_env.Append(CXXFLAGS=['-fno-access-control'])
local.Alias('skin-rig-benchmark', local.Program('skin-rig-benchmark',
    skin_game_env.Object('SkinRigBenchmark.o', '#tools/skins/rig_benchmark.cpp')
    + ['../libgag/src/libgag.a', '../libusl/src/libusl.a']))
local.Alias('skin-game-preview', local.Program('skin-game-preview',
    [skin_game_env.Object('SkinGamePreview.o', '#tools/skins/game_preview.cpp')]
    + client_objects + client_libs))
