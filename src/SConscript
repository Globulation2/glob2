Import('env')
local = env.Clone()
#Add libgag and USL, not as a library, but as an object
source_files.append("../libgag/src/libgag.a")
source_files.append("../libusl/src/libusl.a")
p1 = local.Program("glob2", source_files)

if not env['server']:
    ledger_env = local.Clone()
    ledger_env.Append(CCFLAGS=['-UNDEBUG'])
    ledger_test = local.Program('MaximaFoodLedgerStandaloneTest', [
        ledger_env.Object('MaximaFoodLedgerStandaloneTest.o', '#test/MaximaFoodLedgerStandaloneTest.cpp'),
        local.Object('AIMaximaFoodLedger.cpp')])
    local.Alias('maxima-food-ledger-test', ledger_test)

if not env['server']:
    continuation_env = local.Clone()
    continuation_env['LINKFLAGS'] = [flag for flag in local.Split(local['LINKFLAGS']) if flag != '-mwindows']
    continuation_env['LIBS'] = [lib for lib in local['LIBS'] if lib != 'SDL2main']
    continuation_test = continuation_env.Program('MaximaContinuationTest', [
        local.Object('MaximaContinuationTest.o', '#test/MaximaContinuationTest.cpp'),
        '../libgag/src/libgag.a'])
    local.Alias('maxima-continuation-test', continuation_test)

if not env['server']:
    geometry_sources = [source for source in source_files if source != 'Glob2.cpp']
    geometry_sources += local.Object('CortexGeometryHarness.o', '#test/CortexGeometryHarness.cpp')
    geometry_test = local.Program('CortexGeometryHarness', geometry_sources)
    local.Alias('cortex-geometry-test', geometry_test)

# Optional integration executable; normal game/server builds do not build it.
if not env['server']:
    relocation_test = local.Program("MaximaRelocationIntegrationTest",
        [source for source in source_files if source != "Glob2.cpp"] +
        [local.Object("MaximaRelocationIntegrationTest", "#test/MaximaRelocationIntegrationTest.cpp")])
    local.Alias("maxima-relocation-test", relocation_test)
    render_test = local.Program("torus-render-test",
        [source for source in source_files if source != "Glob2.cpp"] +
        [local.Object("TorusRenderIntegrationTest", "#test/TorusRenderIntegrationTest.cpp")])
    local.Alias("torus-render-test", render_test)
    render_benchmark = local.Program("torus-render-benchmark",
        [source for source in source_files if source != "Glob2.cpp"] +
        [local.Object("TorusRenderBenchmark", "#test/TorusRenderBenchmark.cpp")])
    local.Alias("torus-render-benchmark", render_benchmark)

if not env['server']:
    # Compile with local, not stats_env, to avoid rebuilding shared objects under a second environment.
    stats_sources = local.Object([source for source in source_files if source != 'Glob2.cpp' and source.endswith('.cpp')])
    stats_sources += [source for source in source_files if not source.endswith('.cpp')]
    stats_sources += local.Object('TeamStatsSaveHarness.o', '#test/TeamStatsSaveHarness.cpp')
    stats_env = local.Clone()
    stats_env['LINKFLAGS'] = [flag for flag in local.Split(local['LINKFLAGS']) if flag != '-mwindows']
    stats_env['LIBS'] = [lib for lib in local['LIBS'] if lib != 'SDL2main']
    stats_test = stats_env.Program('TeamStatsSaveHarness', stats_sources)
    local.Alias('team-stats-save-test', stats_test)

# Integration harness: reuse the client objects with a test entry point.
# Explicit target only; the server and normal client build remain unchanged.
if not env['server']:
    selection_sources = [source for source in source_files if source != 'Glob2.cpp']
    selection_sources += local.Object('GameGUISelectionHarness.o', '#test/GameGUISelectionHarness.cpp')
    selection_test = local.Program('GameGUISelectionHarness', selection_sources)
    local.Alias('selection-test', selection_test)

if not env['server']:
    terrain_sources = [source for source in source_files if source != 'Glob2.cpp']
    terrain_sources += local.Object('TerrainResourcesHarness.o', '#test/TerrainResourcesHarness.cpp')
    terrain_test = local.Program('TerrainResourcesHarness', terrain_sources)
    local.Alias('terrain-test', terrain_test)

if not env['server']:
    farming_sources = [source for source in source_files if source != 'Glob2.cpp']
    farming_sources += local.Object('NicowarFarmingHarness.o', '#test/NicowarFarmingHarness.cpp')
    farming_test = local.Program('NicowarFarmingHarness', farming_sources)
    local.Alias('nicowar-farming-test', farming_test)

if not env['server']:
    gradient_sources = [source for source in source_files if source != 'Glob2.cpp']
    gradient_sources += local.Object('GlobalGradientHarness.o', '#test/GlobalGradientHarness.cpp')
    gradient_test = local.Program('GlobalGradientHarness', gradient_sources)
    local.Alias('global-gradient-test', gradient_test)

if not env['server']:
    lan_sources = [source for source in source_files if source != 'Glob2.cpp']
    lan_sources += local.Object('LANSessionHarness.o', '#test/LANSessionHarness.cpp')
    lan_test = local.Program('LANSessionHarness', lan_sources)
    local.Alias('lan-test', lan_test)

if not env['server']:
    settings_sources = [source for source in source_files if source != 'Glob2.cpp']
    settings_sources += local.Object('SettingsScreenTest.o', '#test/SettingsScreenTest.cpp')
    settings_test = local.Program('settings-screen-tests', settings_sources)
    local.Alias('settings-tests', settings_test)

if not env['server']:
    speed_sources = [source for source in source_files if source != 'Glob2.cpp']
    speed_sources += local.Object('GameSpeedTest.o', '#test/GameSpeedTest.cpp')
    speed_test = local.Program('game-speed-tests', speed_sources)
    local.Alias('speed-tests', speed_test)

if not env['server']:
    # Compile with local, not savegame_env, to avoid rebuilding shared objects under a second environment.
    savegame_sources = local.Object([source for source in source_files if source != 'Glob2.cpp' and source.endswith('.cpp')])
    savegame_sources += [source for source in source_files if not source.endswith('.cpp')]
    savegame_sources += local.Object('SavegameSafetyHarness.o', '#test/SavegameSafetyHarness.cpp')
    savegame_env = local.Clone()
    # Headless tests use a console entry point so failures reach the CI log.
    savegame_env['LINKFLAGS'] = [flag for flag in local.Split(local['LINKFLAGS']) if flag != '-mwindows']
    savegame_env['LIBS'] = [lib for lib in local['LIBS'] if lib != 'SDL2main']
    savegame_test = savegame_env.Program('SavegameSafetyHarness', savegame_sources)
    local.Alias('savegame-safety-test', savegame_test)

if not env['server']:
    # Compile with local, not clearing_env, to avoid rebuilding shared objects under a second environment.
    clearing_sources = local.Object([source for source in source_files if source != 'Glob2.cpp' and source.endswith('.cpp')])
    clearing_sources += [source for source in source_files if not source.endswith('.cpp')]
    clearing_sources += local.Object('ClearingFlagGradientTest.o', '#test/ClearingFlagGradientTest.cpp')
    clearing_env = local.Clone()
    # Headless tests use a console entry point so failures reach the CI log.
    clearing_env['LINKFLAGS'] = [flag for flag in local.Split(local['LINKFLAGS']) if flag != '-mwindows']
    clearing_env['LIBS'] = [lib for lib in local['LIBS'] if lib != 'SDL2main']
    clearing_test = clearing_env.Program('ClearingFlagGradientTest', clearing_sources)
    local.Alias('clearing-gradient-test', clearing_test)

