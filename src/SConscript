from sources import CLIENT_SOURCES
source_files = list(CLIENT_SOURCES)
from sources import SERVER_SOURCES
server_source_files = list(SERVER_SOURCES)
Import('env')
if not env.get('wss', True):
    source_files.remove('net/WssTransport.cpp')
    source_files.remove('online/HttpFetch.cpp')
local = env.Clone()
platform_trust_sources = []
if env['PLATFORM'] in ('darwin', 'win32') or env.get('mingw') or env.get('mingwcross'):
    platform_trust_sources = local.Object('PlatformTrustCore.o', '#mobile/CertificateTrust.cpp')
    platform_trust_sources += local.Object('PlatformTrustPolicy.o', '#mobile/ios/CertificateTrust.cpp' if env['PLATFORM'] == 'darwin' else 'net/WindowsCertificateTrust.cpp')
source_files += platform_trust_sources
server_source_files += platform_trust_sources
if not env['server']:
    js_library = SConscript('#third_party/SConscript', variant_dir=Dir('#' + env['BUILDDIR'] + '/third_party'), duplicate=0, exports={'env': env})
    local.Append(CPPPATH=['#third_party/quickjs-ng'])
    source_files += [node.abspath for node in js_library]

# Host numeric conversion must use the same strict boundary as the interpreter.
strict = local.Clone()
strict.Append(CXXFLAGS=['-fno-fast-math', '-ffp-contract=off'])
strict_sources = [source for source in source_files
                  if isinstance(source, str) and source.endswith('.cpp') and (source.startswith('script/') or source == 'ai/AIJavaScript.cpp')]
from javascript import numeric_guard
strict_objects = dict(zip(strict_sources, [strict.Object(source)[0] for source in strict_sources]))
numeric_guard(strict, list(strict_objects.values()))
# Resolve these sources explicitly so Program does not compile them with generic flags.
program_sources = [strict_objects.get(source, source) for source in source_files]

#Add libgag and USL, not as a library, but as an object
source_files.append("../libgag/src/libgag.a")
source_files.append("../libusl/src/libusl.a")
p1 = local.Program("glob2", program_sources + ["../libgag/src/libgag.a", "../libusl/src/libusl.a"])

# Shared with test/SConscript: every client object except the entry point, so test
# binaries link exactly the objects the game was built from and nothing compiles twice.
if not env['server']:
    client_cpp_sources = [source for source in source_files if isinstance(source, str) and source != 'Glob2.cpp' and source.endswith('.cpp')]
    client_objects = [strict_objects[source] if source in strict_objects else local.Object(source)[0]
                      for source in client_cpp_sources]
    client_object_by_source = dict(zip(client_cpp_sources, client_objects))
    client_objects += platform_trust_sources
    client_libs = [local.File(source) for source in source_files if isinstance(source, str) and not source.endswith('.cpp')]
    Export('client_objects', 'client_object_by_source', 'client_libs')


if not env['server']:
    lan_sources = [strict_objects.get(source, source) for source in source_files if source != 'Glob2.cpp']
    lan_sources += local.Object('LANSessionHarness.o', '#test/LANSessionHarness.cpp')
    lan_test = local.Program('LANSessionHarness', lan_sources)
    local.Alias('lan-test', lan_test)

# Twelve-team sprite benchmark; not part of the default build.
if not env['server']:
    twelve_team_benchmark = local.Program('twelve-team-benchmark',
        local.Object('TwelveTeamBenchmark.o', '#tools/unit-animation/twelve-team-benchmark.cpp')
        + ['../libgag/src/libgag.a', '../libusl/src/libusl.a'])
    local.Alias('twelve-team-benchmark', twelve_team_benchmark)

# Map analysis tools and the golden test use production generators and widgets.
if not env['server']:
    for alias, target in [('map-generator-study', 'MapGeneratorStudy'),
                          ('map-generator-golden-test', 'MapGeneratorGoldenTest'),
                          ('map-generator-profile-fixture', 'MapGeneratorProfileFixture')]:
        sources = [strict_objects.get(source, source) for source in source_files if source != 'Glob2.cpp']
        sources += local.Object(target + '.o', '#test/' + target + '.cpp')
        local.Alias(alias, local.Program(target, sources))
if not env['server']:
    transport_sources = [strict_objects.get(source, source) for source in source_files if source != 'Glob2.cpp']
    transport_sources += local.Object('NetConnectionHarness.o', '#test/NetConnectionHarness.cpp')
    transport_test = local.Program('net-connection-test', transport_sources)
    local.Alias('transport-test', transport_test)
    peer_sources = [strict_objects.get(source, source) for source in source_files if source != 'Glob2.cpp']
    peer_sources += local.Object('NativeMultiplayerPeer.o', '#test/NativeMultiplayerPeer.cpp')
    peer_test = local.Program('native-multiplayer-peer', peer_sources)
    local.Alias('transport-test', peer_test)
    discovery_test = local.Program('lan-discovery-test', [
        'net/NetBroadcastListener.cpp', 'net/NetBroadcaster.cpp', 'net/NetworkConfig.cpp', 'net/LanIdentity.cpp',
        local.Object('LANDiscoveryHarness.o', '#test/LANDiscoveryHarness.cpp')])
    local.Alias('transport-test', discovery_test)
    if env.get('wss', True):
        wss_test = local.Program('wss-transport-test', [
            'net/NetTransport.cpp', 'net/WssTransport.cpp', 'net/NetworkConfig.cpp', 'net/LanIdentity.cpp',
            local.Object('WssTransportHarness.o', '#test/WssTransportHarness.cpp')] + platform_trust_sources)
        local.Alias('transport-test', wss_test)
        listener_test = local.Program('wss-listener-test', [
            'net/NetTransport.cpp', 'net/WssTransport.cpp', 'net/NetworkConfig.cpp', 'net/LanIdentity.cpp',
            local.Object('WssListenerHarness.o', '#test/WssListenerHarness.cpp')] + platform_trust_sources)
        local.Alias('transport-test', listener_test)
        http_test = local.Program('http-fetch-test', [
            'online/HttpFetch.cpp', 'online/HttpFetchCommon.cpp',
            local.Object('HttpFetchHarness.o', '#test/HttpFetchHarness.cpp')] + platform_trust_sources)
        local.Alias('transport-test', http_test)
        platform_probe = local.Program('platform-client-probe', [
            'online/HttpFetch.cpp', 'online/HttpFetchCommon.cpp', 'online/InstanceConfig.cpp',
            'online/MemoryStorage.cpp', 'online/PlatformClient.cpp', 'online/PlatformProtocol.cpp',
            'net/NetTransport.cpp', 'net/WssTransport.cpp', 'net/NetworkConfig.cpp', 'net/LanIdentity.cpp',
            local.Object('PlatformClientProbe.o', '#test/PlatformClientProbe.cpp')] + platform_trust_sources)
        local.Alias('transport-test', platform_probe)

#Add libgag, not as a library, but as an object
server_source_files.append("../libgag/src/libgag_server.a")
p2 = local.Program("glob2-router" if env.get("role") == "router" else "glob2-server", server_source_files)

if not env['server']:
    local.Default(p1)
else:
    local.Default(p2)

Import('env')
Import("PackTar")

if 'dist' in COMMAND_LINE_TARGETS or 'install' in COMMAND_LINE_TARGETS:
    env.Install(env["BINDIR"], "glob2")
    env.Alias("install", env["BINDIR"])

    import os
    for file in os.listdir("."):
        if file.find(".cpp") != -1 or file.find(".h") != -1 or file.find(".py") != -1:
            PackTar(env["TARFILE"], file)

    PackTar(env["TARFILE"], "SConscript")

# Offline production-screen capture for the mobile design review gallery.
if not env['server']:
    gallery_sources = [strict_objects.get(source, source) for source in source_files if source != 'Glob2.cpp']
    gallery_sources += local.Object('MobileGalleryHarness.o', '#tools/MobileGalleryHarness.cpp')
    local.Alias('mobile-gallery', local.Program('mobile-gallery', gallery_sources))
