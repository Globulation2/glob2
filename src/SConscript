    # Use the real renderer and settings handlers. Access relaxation is confined
    # to the test translation unit; production objects retain their normal flags.
    render_env = savegame_env.Clone()
    render_env['CXXFLAGS'] = local.Split(local['CXXFLAGS']) + ['-fno-access-control']
    render_sources = [obj for obj in savegame_sources
                      if str(obj).split('/')[-1] not in ('SavegameSafetyHarness.o', 'CreditScreen.o')]
    render_sources += render_env.Object('MapRenderResizeHarness.o', '#test/MapRenderResizeHarness.cpp')
    render_test = savegame_env.Program('MapRenderResizeHarness', render_sources)
    local.Alias('map-render-resize-test', render_test)


if not env['server']:
    # Compile with local, not trapped_env, to avoid rebuilding shared objects under a second environment.
    trapped_sources = local.Object([source for source in source_files if source != 'Glob2.cpp' and source.endswith('.cpp')])
    trapped_sources += [source for source in source_files if not source.endswith('.cpp')]
