Import('env')
from sources import profile_sources
source_files = list(profile_sources(env.get('compile_profile', 'full')))
if env.get('role') == 'relay':
    # The relay role builds glob2-relay and its tests only.
    from sources import RELAY_SOURCES, RELAY_GAG_SOURCES
    relay_env = env.Clone()
    relay_env.Append(CPPPATH=['#src/relay'])
    relay_env['LIBS'] = [lib for lib in relay_env.get('LIBS', []) if lib in ('ssl', 'crypto', 'pthread')]
    from dev_compile import objects as development_objects, unique
    from build_timing import record
    relay_mapping = development_objects(relay_env, list(RELAY_SOURCES), lambda source: relay_env.File(source[:-4] + '.o').abspath)
    relay_objects = unique(relay_mapping.values())
    relay_objects += [relay_env.Object('relay-gag-' + source.replace('.cpp', '.o'), '#libs/gag/src/' + source)
                      for source in RELAY_GAG_SOURCES]
    record(relay_env, relay_objects, 'compile')
    relay_main = relay_env.Object('relay/RelayMain.cpp')
    record(relay_env, relay_main, 'compile')
    relay = record(relay_env, relay_env.Program('glob2-relay', relay_objects + relay_main), 'link')
    relay_env.Default(relay)
    relay_env.Alias('relay', relay)
    tests_env = relay_env.Clone()
    tests_env.Append(CPPPATH=['#test/third_party'])
    tests_env.Append(CPPDEFINES=[('RELAY_FIXTURE_DIR', '\\"%s\\"' % Dir('#test/fixtures/relay-tickets').abspath)])
    relay_tests = tests_env.Program('glob2-relay-tests', relay_objects + [
        tests_env.Object('relay-test-' + name + '.o', '#src/relay/' + name + '.cpp')
        for name in ('RelayTestMain', 'RelayTicketTest', 'RelayAdmissionTest')])
    tests_env.Alias('relay-tests', relay_tests)
    tests_env.Alias('relay', relay_tests)
    Return()
if not env.get('wss', True):
    source_files.remove('net/WssTransport.cpp')
    source_files.remove('online/HttpFetch.cpp')
if env.get('target', 'native') not in ('web', 'android', 'ios') and not env.get('server'):
    source_files += ['mcp/Tools.cpp', 'mcp/Protocol.cpp', 'mcp/HttpServer.cpp']
local = env.Clone()
from online_error_catalog import configure as configure_online_error_catalog, bind_objects as bind_online_error_objects, bind_consumer as bind_online_error_consumer
from pathlib import Path
online_error_catalog = configure_online_error_catalog(local, Path(Dir('#').abspath) / env['BUILDDIR'] / 'include')
from skin_render import configure as configure_skin_render
configure_skin_render(local)
platform_trust_sources = []
if env['PLATFORM'] in ('darwin', 'win32') or env.get('mingw') or env.get('mingwcross'):
    platform_trust_sources = local.Object('PlatformTrustCore.o', '#platforms/mobile/CertificateTrust.cpp')
    platform_trust_sources += local.Object('PlatformTrustPolicy.o', '#platforms/mobile/ios/CertificateTrust.cpp' if env['PLATFORM'] == 'darwin' else 'net/WindowsCertificateTrust.cpp')
source_files += platform_trust_sources
js_library = SConscript('#third_party/SConscript', variant_dir=Dir('#' + env['BUILDDIR'] + '/third_party'), duplicate=0, exports={'env': env})
local.Append(CPPPATH=['#third_party/quickjs-ng'])
source_files += [node.abspath for node in js_library]

# Host numeric conversion must use the same strict boundary as the interpreter.
strict = local.Clone()
from javascript import numeric_guard, strict_numeric_source, guarded_numeric_source, STRICT_CXXFLAGS
strict.Append(CXXFLAGS=list(STRICT_CXXFLAGS))
strict_sources = [source for source in source_files
                  if isinstance(source, str) and strict_numeric_source(source)]
from dev_compile import objects as development_objects, unique
strict_mapping = development_objects(strict, strict_sources,
    lambda source: local.File(source.removeprefix('#src/')[:-4] + '.o').abspath)
strict_objects = {source: strict_mapping[source] for source in strict_sources}
numeric_guard(strict, [obj for source, obj in strict_objects.items() if guarded_numeric_source(source)])
ordinary_sources = [source for source in source_files if isinstance(source, str) and source.endswith('.cpp') and source not in strict_objects]
ordinary_mapping = development_objects(local, ordinary_sources,
    lambda source: local.File(source.removeprefix('#src/')[:-4] + '.o').abspath)
strict_objects.update({source: ordinary_mapping[source] for source in ordinary_sources})
bind_online_error_objects(local, ordinary_mapping, online_error_catalog)
def development_program(target, sources):
    from build_timing import record
    return record(local, local.Program(target, unique([strict_objects.get(source, source) if isinstance(source, str) else source for source in sources])), "link")

# Serve the same player contract across native, browser and mobile builds.
from hive_api import configure as configure_hive_api
hive_contract = configure_hive_api(local, local['BUILDDIR'])
local.Depends(ordinary_mapping['hive/LocalCommander.cpp'], hive_contract)

# Resolve these sources explicitly so Program does not compile them with generic flags.
program_sources = unique([strict_objects.get(source, source) for source in source_files])

#Add libgag and USL, not as a library, but as an object
source_files.append("../libs/gag/src/libgag.a")
source_files.append("../libs/usl/src/libusl.a")
p1 = development_program("glob2", program_sources + ["../libs/gag/src/libgag.a", "../libs/usl/src/libusl.a"])
if env.get("RUNTIME_ASSET_STAMP"):
    local.Depends(p1, env["RUNTIME_ASSET_STAMP"])

# Shared with test/SConscript: every client object except the entry point, so test
# binaries link exactly the objects the game was built from and nothing compiles twice.
client_cpp_sources = [source for source in source_files if isinstance(source, str) and source != 'app/Glob2.cpp' and source.endswith('.cpp')]
client_objects = [strict_objects[source] if source in strict_objects else local.Object(source)[0]
                  for source in client_cpp_sources]
client_object_by_source = dict(zip(client_cpp_sources, client_objects))
client_objects = unique(client_objects)
client_objects += platform_trust_sources
client_libs = [local.File(source) for source in source_files if isinstance(source, str) and not source.endswith('.cpp')]
# Module libraries over the same objects (scons/sources.py MODULE_SOURCES). Only the
# module test binaries link them; the game keeps linking the loose objects above.
from sources import MODULE_SOURCES
module_libraries = {name: local.StaticLibrary('glob2_' + name, unique(
                        [client_object_by_source[source] for source in group if source in client_object_by_source]))
                    for name, group in MODULE_SOURCES.items()}
Export('client_objects', 'client_object_by_source', 'client_libs', 'online_error_catalog', 'module_libraries')


# Harness and tool programs (scons/harness_programs.py, shared with the CMake build).
from harness_programs import HARNESS_PROGRAMS, SHARED_OBJECTS, CLIENT, CLIENT_OBJECTS, LIBRARIES, object_name
from sources import profile_features
profile_groups = profile_features(env.get('compile_profile', 'full'))
shared_objects = {}


def harness_sources(program):
    flags = {'CXXFLAGS': local['CXXFLAGS'] + list(program.cxxflags)} if program.cxxflags else {}
    harness = local.Object(object_name(program), program.source, **flags)
    for name in program.shared:
        if name not in shared_objects:
            shared_objects[name] = local.Object(*SHARED_OBJECTS[name])
        harness += shared_objects[name]
    trust = platform_trust_sources if program.trust else []
    if program.link == CLIENT:
        return [strict_objects.get(source, source) for source in source_files if source != 'app/Glob2.cpp'] + harness + trust
    if program.link == CLIENT_OBJECTS:
        return harness + trust + client_objects + client_libs
    if program.link == LIBRARIES:
        return harness + trust + ['../libs/gag/src/libgag.a', '../libs/usl/src/libusl.a']
    return list(program.link) + harness + trust


for program in HARNESS_PROGRAMS:
    if program.require == 'wss' and not env.get('wss', True):
        continue
    if program.profile and program.profile not in profile_groups:
        continue  # compile_profile=core leaves out the code it drives
    local.Alias(program.alias, development_program(program.target, harness_sources(program)))

local.Default(p1)

Import('env')
Import("PackTar")

if 'dist' in COMMAND_LINE_TARGETS or 'install' in COMMAND_LINE_TARGETS:
    env.Install(env["BINDIR"], "glob2")
    env.Alias("install", env["BINDIR"])

    import os
    for directory, _, names in os.walk("."):
        for file in names:
            if file.find(".cpp") != -1 or file.find(".h") != -1 or file.find(".py") != -1:
                PackTar(env["TARFILE"], os.path.join(directory, file))

    PackTar(env["TARFILE"], "SConscript")

