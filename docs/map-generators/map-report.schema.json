        "reachable_build_sites_4x4": {
          "type": "integer",
          "description": ""
        },
        "catchment_build_sites_4x4": {
          "type": "integer",
          "description": ""
        },
        "exclusive_nearest_territory_tiles": {
          "type": "integer",
          "description": ""
        },
        "tied_nearest_territory_tiles": {
          "type": "integer",
          "description": ""
        },
        "resources": {
          "type": "object",
          "properties": {
            "wood": {
              "$ref": "#/$defs/access"
            },
            "wheat": {
              "$ref": "#/$defs/access"
            },
            "papyrus": {
              "$ref": "#/$defs/access"
            },
            "stone": {
              "$ref": "#/$defs/access"
            },
            "algae": {
              "$ref": "#/$defs/access"
            },
            "cherry": {
              "$ref": "#/$defs/access"
