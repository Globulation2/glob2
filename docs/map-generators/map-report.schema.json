            "null"
          ],
          "description": "Cost to the nearest neighbor of a positive-amount deposit, plus one."
        },
        "reachable_deposit_tiles": {
          "type": "integer",
          "description": "Deposit counts or stored amounts; zero if none accessible."
        },
        "reachable_stored_amount": {
          "type": "integer",
          "description": "Deposit counts or stored amounts; zero if none accessible."
        },
        "catchment_deposit_tiles": {
          "type": "integer",
          "description": "Deposit counts or stored amounts; zero if none accessible."
        },
        "catchment_stored_amount": {
          "type": "integer",
          "description": "Deposit counts or stored amounts; zero if none accessible."
        }
      },
      "required": [
        "nearest_gather_cost",
        "reachable_deposit_tiles",
        "reachable_stored_amount",
        "catchment_deposit_tiles",
        "catchment_stored_amount"
      ],
      "additionalProperties": false
    },
    "movement_colony": {
      "type": "object",
      "properties": {
        "team": {
          "type": "integer",
          "description": ""
        },
        "source_tiles": {
          "type": "integer",
