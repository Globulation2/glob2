# Copy to .env (ignored by git) and adjust. Variables already set in the
# environment take precedence over this file.

# Postgres connection used by every service.
DATABASE_URL=postgres://glob2:glob2@127.0.0.1:5432/glob2

# Origin players reach the instance at (no trailing slash).
PUBLIC_ORIGIN=http://localhost:8080

# api listen address.
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Blob storage: fs (directory, default) or s3 (not implemented yet).
BLOB_STORE=fs
BLOB_DIR=data/blobs

# Path to instance settings (default ./instance.yaml; built-in defaults if absent).
# INSTANCE_CONFIG=instance.yaml

# Seconds to finish in-flight work after SIGTERM.
SHUTDOWN_GRACE_SECONDS=25

# engine-agent only: sim version key of the bundled glob2 binary.
# ENGINE_SIM_VERSION=125-49-<64 hex digits>
# ENGINE_BUILD=glob2-0.9.25
# ENGINE_CONCURRENCY=1

# Secrets referenced from instance.yaml by name, e.g.
# GOOGLE_CLIENT_SECRET=...

# Tests: a Postgres role allowed to CREATE DATABASE.
# TEST_DATABASE_URL=postgres://glob2:glob2@127.0.0.1:55432/postgres
