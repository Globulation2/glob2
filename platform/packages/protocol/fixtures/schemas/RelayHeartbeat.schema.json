{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:RelayHeartbeat",
  "title": "RelayHeartbeat",
  "type": "object",
  "required": [
    "relayId",
    "load",
    "draining",
    "activeMatchIds"
  ],
  "properties": {
    "relayId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "load": {
      "type": "object",
      "required": [
        "matches",
        "connections"
      ],
      "properties": {
        "matches": {
          "type": "integer",
          "minimum": 0
        },
        "connections": {
          "type": "integer",
          "minimum": 0
        },
        "cpu": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of capacity."
        }
      },
      "additionalProperties": false
    },
    "draining": {
      "type": "boolean"
    },
    "activeMatchIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "description": "Lowercase UUID."
      },
      "maxItems": 10000
    }
  },
  "additionalProperties": false,
  "description": "Periodic relay health and load report."
}
