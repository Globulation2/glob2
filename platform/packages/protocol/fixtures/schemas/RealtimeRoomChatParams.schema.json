{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:RealtimeRoomChatParams",
  "title": "RealtimeRoomChatParams",
  "type": "object",
  "required": [
    "roomId",
    "text"
  ],
  "properties": {
    "roomId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "additionalProperties": false
}
