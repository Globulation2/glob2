{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:PublishSetRequest",
  "title": "PublishSetRequest",
  "type": "object",
  "required": [
    "revision",
    "visibility",
    "label",
    "notes"
  ],
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "visibility": {
      "anyOf": [
        {
          "type": "string",
          "const": "public"
        },
        {
          "type": "string",
          "const": "unlisted"
        },
        {
          "type": "string",
          "const": "private"
        }
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "additionalProperties": false
}
