{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:MatchColonySkin",
  "title": "MatchColonySkin",
  "type": "object",
  "required": [
    "team",
    "accountId",
    "version",
    "buildingColor",
    "assertion"
  ],
  "properties": {
    "softwareSprites": {
      "type": "object",
      "required": [
        "format",
        "manifestSha256",
        "renderRevision"
      ],
      "properties": {
        "format": {
          "type": "string",
          "const": "colony-sprites-v1"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase hexadecimal SHA-256 digest."
        },
        "renderRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase hexadecimal SHA-256 digest."
        }
      }
    },
    "team": {
      "type": "integer",
      "minimum": 0,
      "maximum": 11
    },
    "accountId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "version": {
      "type": "object",
      "required": [
        "id",
        "skinId",
        "textureSha256",
        "materialSha256",
        "manifestSha256",
        "layout",
        "buildingColor",
        "swarmMesh"
      ],
      "properties": {
        "softwareStatus": {
          "anyOf": [
            {
              "type": "string",
              "const": "pending"
            },
            {
              "type": "string",
              "const": "ready"
            },
            {
              "type": "string",
              "const": "failed"
            }
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "Lowercase UUID."
        },
        "skinId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "Lowercase UUID."
        },
        "textureSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase hexadecimal SHA-256 digest."
        },
        "materialSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase hexadecimal SHA-256 digest."
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase hexadecimal SHA-256 digest."
        },
        "layout": {
          "type": "string",
          "const": "colony-v2"
        },
        "buildingColor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777215
        },
        "swarmMesh": {
          "anyOf": [
            {
              "type": "string",
              "const": "classic"
            },
            {
              "type": "string",
              "const": "crown"
            },
            {
              "type": "string",
              "const": "clutch"
            },
            {
              "type": "string",
              "const": "toadstool"
            },
            {
              "type": "string",
              "const": "coral"
            },
            {
              "type": "string",
              "const": "skep"
            },
            {
              "type": "string",
              "const": "bloom"
            }
          ]
        },
        "swarmViewAngle": {
          "type": "integer",
          "minimum": 0,
          "maximum": 359
        }
      }
    },
    "buildingColor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16777215
    },
    "assertion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    }
  }
}
