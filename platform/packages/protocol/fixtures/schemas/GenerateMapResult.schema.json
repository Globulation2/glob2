{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:GenerateMapResult",
  "title": "GenerateMapResult",
  "type": "object",
  "required": [
    "mapHash",
    "size",
    "map",
    "chosenSeed"
  ],
  "properties": {
    "mapHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase hexadecimal SHA-256 digest."
    },
    "size": {
      "type": "integer",
      "minimum": 0
    },
    "map": {
      "type": "object",
      "required": [
        "width",
        "height",
        "teamCount"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "teamCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      }
    },
    "chosenSeed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "startQuality": {
      "type": "object",
      "required": [
        "fairness",
        "score"
      ],
      "properties": {
        "fairness": {
          "type": "number"
        },
        "score": {
          "type": "number"
        }
      },
      "description": "Lobby start quality."
    }
  }
}
