{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:GenerateMapResult",
  "title": "GenerateMapResult",
  "type": "object",
  "required": [
    "mapHash",
    "size",
    "map",
    "chosenSeed"
  ],
  "properties": {
    "mapHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase hexadecimal SHA-256 digest."
    },
    "size": {
      "type": "integer",
      "minimum": 0
    },
    "map": {
      "type": "object",
      "required": [
        "width",
        "height",
        "teamCount"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "teamCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "buildingCatalog": {
          "type": "object",
          "required": [
            "snapshot",
            "hash"
          ],
          "properties": {
            "snapshot": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8388608
            },
            "hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "Lowercase hexadecimal SHA-256 digest."
            }
          },
          "additionalProperties": false
        },
        "resourceExperiments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "label",
              "help"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "minLength": 1,
                "maxLength": 128
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "help": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "additionalProperties": false
          },
          "maxItems": 64
        },
        "requiredResourceExperiments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        }
      }
    },
    "chosenSeed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "startQuality": {
      "type": "object",
      "required": [
        "fairness",
        "score"
      ],
      "properties": {
        "fairness": {
          "type": "number"
        },
        "score": {
          "type": "number"
        }
      },
      "description": "Lobby start quality."
    }
  }
}
