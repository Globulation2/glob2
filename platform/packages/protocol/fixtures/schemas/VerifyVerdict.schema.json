{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:VerifyVerdict",
  "title": "VerifyVerdict",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "verdict",
        "outcome"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "const": "verified"
        },
        "outcome": {
          "type": "object",
          "required": [
            "finalTick",
            "teams",
            "resultHash",
            "replayHash"
          ],
          "properties": {
            "finalTick": {
              "type": "integer",
              "minimum": 0
            },
            "teams": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "team",
                  "outcome",
                  "prestige"
                ],
                "properties": {
                  "team": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 11
                  },
                  "outcome": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "won"
                      },
                      {
                        "type": "string",
                        "const": "lost"
                      },
                      {
                        "type": "string",
                        "const": "unresolved"
                      }
                    ]
                  },
                  "eliminatedTick": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "prestige": {
                    "type": "integer"
                  },
                  "statistics": {
                    "type": "object",
                    "patternProperties": {
                      "^[A-Za-z][A-Za-z0-9]{0,63}$": {
                        "type": "number"
                      }
                    },
                    "maxProperties": 64,
                    "description": "Final team counters from the verifier result (units, workers, buildings, totalHp, food, …)."
                  },
                  "timeline": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "tick",
                        "units",
                        "buildings",
                        "prestige",
                        "hp",
                        "attack",
                        "defense"
                      ],
                      "properties": {
                        "tick": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "units": {
                          "type": "integer"
                        },
                        "buildings": {
                          "type": "integer"
                        },
                        "prestige": {
                          "type": "integer"
                        },
                        "hp": {
                          "type": "integer"
                        },
                        "attack": {
                          "type": "integer"
                        },
                        "defense": {
                          "type": "integer"
                        }
                      },
                      "description": "One sample of the engine's end-of-game statistics, taken every 512 ticks."
                    },
                    "maxItems": 4096,
                    "description": "Team history from the verifier result, oldest first."
                  }
                }
              }
            },
            "resultHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "Lowercase hexadecimal SHA-256 digest."
            },
            "replayHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "Lowercase hexadecimal SHA-256 digest."
            }
          },
          "description": "Outcome replayed by the engine; result.json and .replay are stored as blobs."
        }
      }
    },
    {
      "type": "object",
      "required": [
        "verdict",
        "clients",
        "outcome"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "const": "diverged"
        },
        "clients": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 11
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Seats whose reported checksums disagree with the verifier."
        },
        "outcome": {
          "type": "object",
          "required": [
            "finalTick",
            "teams",
            "resultHash",
            "replayHash"
          ],
          "properties": {
            "finalTick": {
              "type": "integer",
              "minimum": 0
            },
            "teams": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "team",
                  "outcome",
                  "prestige"
                ],
                "properties": {
                  "team": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 11
                  },
                  "outcome": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "won"
                      },
                      {
                        "type": "string",
                        "const": "lost"
                      },
                      {
                        "type": "string",
                        "const": "unresolved"
                      }
                    ]
                  },
                  "eliminatedTick": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "prestige": {
                    "type": "integer"
                  },
                  "statistics": {
                    "type": "object",
                    "patternProperties": {
                      "^[A-Za-z][A-Za-z0-9]{0,63}$": {
                        "type": "number"
                      }
                    },
                    "maxProperties": 64,
                    "description": "Final team counters from the verifier result (units, workers, buildings, totalHp, food, …)."
                  },
                  "timeline": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "tick",
                        "units",
                        "buildings",
                        "prestige",
                        "hp",
                        "attack",
                        "defense"
                      ],
                      "properties": {
                        "tick": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "units": {
                          "type": "integer"
                        },
                        "buildings": {
                          "type": "integer"
                        },
                        "prestige": {
                          "type": "integer"
                        },
                        "hp": {
                          "type": "integer"
                        },
                        "attack": {
                          "type": "integer"
                        },
                        "defense": {
                          "type": "integer"
                        }
                      },
                      "description": "One sample of the engine's end-of-game statistics, taken every 512 ticks."
                    },
                    "maxItems": 4096,
                    "description": "Team history from the verifier result, oldest first."
                  }
                }
              }
            },
            "resultHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "Lowercase hexadecimal SHA-256 digest."
            },
            "replayHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "Lowercase hexadecimal SHA-256 digest."
            }
          },
          "description": "Outcome replayed by the engine; result.json and .replay are stored as blobs."
        }
      }
    },
    {
      "type": "object",
      "required": [
        "verdict",
        "reason"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "const": "unverifiable"
        },
        "reason": {
          "type": "string",
          "maxLength": 2000,
          "description": "No client matched the verifier: engine nondeterminism or a corrupt record."
        }
      }
    }
  ],
  "description": "verify-match result."
}
