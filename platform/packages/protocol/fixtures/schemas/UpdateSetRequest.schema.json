{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:UpdateSetRequest",
  "title": "UpdateSetRequest",
  "type": "object",
  "required": [
    "title",
    "description",
    "visibility",
    "tags"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "visibility": {
      "anyOf": [
        {
          "type": "string",
          "const": "public"
        },
        {
          "type": "string",
          "const": "unlisted"
        },
        {
          "type": "string",
          "const": "private"
        }
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      },
      "maxItems": 8,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
