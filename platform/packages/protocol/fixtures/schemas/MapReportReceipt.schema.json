{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:MapReportReceipt",
  "title": "MapReportReceipt",
  "type": "object",
  "required": [
    "id",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "status": {
      "anyOf": [
        {
          "type": "string",
          "const": "open"
        },
        {
          "type": "string",
          "const": "resolved"
        },
        {
          "type": "string",
          "const": "dismissed"
        }
      ]
    }
  }
}
