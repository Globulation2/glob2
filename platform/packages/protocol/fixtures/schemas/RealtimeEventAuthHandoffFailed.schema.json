{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:RealtimeEventAuthHandoffFailed",
  "title": "RealtimeEventAuthHandoffFailed",
  "type": "object",
  "required": [
    "attemptId",
    "reason"
  ],
  "properties": {
    "attemptId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "const": "expired"
        },
        {
          "type": "string",
          "const": "denied"
        },
        {
          "type": "string",
          "const": "cancelled"
        },
        {
          "type": "string",
          "const": "error"
        }
      ]
    }
  }
}
