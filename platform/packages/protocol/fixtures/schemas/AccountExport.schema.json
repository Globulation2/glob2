        "messages",
        "requests",
        "attempts"
      ],
      "properties": {
        "wallets": {
          "type": "array",
          "items": {
            "type": "object",
            "patternProperties": {
              "^.*$": {}
            }
          }
        },
        "ledger": {
          "type": "array",
          "items": {
            "type": "object",
            "patternProperties": {
              "^.*$": {}
            }
          }
        },
        "calls": {
          "type": "array",
          "items": {
            "type": "object",
            "patternProperties": {
              "^.*$": {}
            }
          }
        },
        "purchases": {
