{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:BuildingAiStudioTurn",
  "title": "BuildingAiStudioTurn",
  "type": "object",
  "required": [
    "id",
    "text",
    "expectedRevision",
    "references"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "expectedRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "Lowercase hexadecimal SHA-256 digest."
      },
      "maxItems": 4,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
