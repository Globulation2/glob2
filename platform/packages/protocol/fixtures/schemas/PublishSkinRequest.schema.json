{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:PublishSkinRequest",
  "title": "PublishSkinRequest",
  "type": "object",
  "required": [
    "name",
    "imageBase64",
    "buildingColor"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "skinId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "imageBase64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 349528,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "buildingColor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16777215
    }
  },
  "additionalProperties": false
}
