{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:MatchTicketClaims",
  "title": "MatchTicketClaims",
  "type": "object",
  "required": [
    "iss",
    "aud",
    "sub",
    "jti",
    "iat",
    "exp",
    "matchId",
    "seat",
    "accountId",
    "simVersion",
    "humanSeats",
    "relayUrl",
    "entitlements"
  ],
  "properties": {
    "iss": {
      "type": "string",
      "description": "Instance origin, e.g. https://play.example.org."
    },
    "aud": {
      "type": "string",
      "const": "glob2-relay"
    },
    "sub": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "jti": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "iat": {
      "type": "integer",
      "minimum": 0
    },
    "nbf": {
      "type": "integer",
      "minimum": 0
    },
    "exp": {
      "type": "integer",
      "minimum": 0
    },
    "matchId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "seat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 11
    },
    "accountId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "simVersion": {
      "type": "object",
      "required": [
        "versionMinor",
        "netProtocol",
        "dataHash"
      ],
      "properties": {
        "versionMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "VERSION_MINOR in src/Version.h (save and simulation format)."
        },
        "netProtocol": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "NET_PROTOCOL_VERSION in src/Version.h."
        },
        "dataHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase hex SHA-256 over the build's simulation data files, as computed by the engine."
        }
      },
      "additionalProperties": false,
      "description": "Identity of a deterministic simulation build."
    },
    "humanSeats": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 11
      },
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "description": "Every human seat of the match; identical in all tickets of a match so the relay knows whom to wait for."
    },
    "relayUrl": {
      "type": "string",
      "pattern": "^(https|wss|http|ws)://[^\\s]+$",
      "maxLength": 2048
    },
    "entitlements": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "maxItems": 64,
      "description": "Entitlement keys of the account. Relays ignore them today."
    }
  },
  "description": "Claims of a match ticket. `sub` equals `accountId`. Relays check that all tickets of a match agree on simVersion and humanSeats."
}
