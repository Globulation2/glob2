{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:MapReportRequest",
  "title": "MapReportRequest",
  "type": "object",
  "required": [
    "reason",
    "details"
  ],
  "properties": {
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "const": "broken"
        },
        {
          "type": "string",
          "const": "offensive"
        },
        {
          "type": "string",
          "const": "copyright"
        },
        {
          "type": "string",
          "const": "other"
        }
      ]
    },
    "details": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "additionalProperties": false
}
