{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:StudioTurn",
  "title": "StudioTurn",
  "type": "object",
  "required": [
    "id",
    "text",
    "settings"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "settings": {
      "type": "object",
      "required": [
        "width",
        "height",
        "players"
      ],
      "properties": {
        "width": {
          "anyOf": [
            {
              "type": "number",
              "const": 128
            },
            {
              "type": "number",
              "const": 256
            },
            {
              "type": "number",
              "const": 512
            }
          ]
        },
        "height": {
          "anyOf": [
            {
              "type": "number",
              "const": 128
            },
            {
              "type": "number",
              "const": 256
            },
            {
              "type": "number",
              "const": 512
            }
          ]
        },
        "players": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        }
      },
      "additionalProperties": false
    },
    "parent": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    }
  },
  "additionalProperties": false
}
