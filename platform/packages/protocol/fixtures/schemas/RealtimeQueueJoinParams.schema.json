{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:RealtimeQueueJoinParams",
  "title": "RealtimeQueueJoinParams",
  "type": "object",
  "required": [
    "queueId",
    "regions"
  ],
  "properties": {
    "queueId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "region",
          "rttMs"
        ],
        "properties": {
          "region": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
            "description": "Operator-chosen region id, e.g. \"eu-west\"."
          },
          "rttMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000
          }
        },
        "additionalProperties": false
      },
      "maxItems": 32,
      "description": "Measured round trip to each relay region."
    },
    "allowAiOpponent": {
      "type": "boolean",
      "description": "\"Allow an AI opponent\": the queue may fill empty seats with AIs after its backfill delay. Default true."
    }
  },
  "additionalProperties": false
}
