{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:EngineJobResult",
  "title": "EngineJobResult",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "jobId",
        "kind",
        "ok",
        "result",
        "agent"
      ],
      "properties": {
        "jobId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "Lowercase UUID."
        },
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "const": "generate-map"
            },
            {
              "type": "string",
              "const": "validate-map"
            },
            {
              "type": "string",
              "const": "render-preview"
            },
            {
              "type": "string",
              "const": "verify-match"
            }
          ]
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "result": {
          "type": "object",
          "properties": {}
        },
        "agent": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    {
      "type": "object",
      "required": [
        "jobId",
        "kind",
        "ok",
        "error",
        "agent"
      ],
      "properties": {
        "jobId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "Lowercase UUID."
        },
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "const": "generate-map"
            },
            {
              "type": "string",
              "const": "validate-map"
            },
            {
              "type": "string",
              "const": "render-preview"
            },
            {
              "type": "string",
              "const": "verify-match"
            }
          ]
        },
        "ok": {
          "type": "boolean",
          "const": false
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "bad_request"
                },
                {
                  "type": "string",
                  "const": "unauthenticated"
                },
                {
                  "type": "string",
                  "const": "forbidden"
                },
                {
                  "type": "string",
                  "const": "access_denied"
                },
                {
                  "type": "string",
                  "const": "not_found"
                },
                {
                  "type": "string",
                  "const": "conflict"
                },
                {
                  "type": "string",
                  "const": "rate_limited"
                },
                {
                  "type": "string",
                  "const": "update_required"
                },
                {
                  "type": "string",
                  "const": "unsupported"
                },
                {
                  "type": "string",
                  "const": "unavailable"
                },
                {
                  "type": "string",
                  "const": "internal"
                }
              ]
            },
            "message": {
              "type": "string",
              "maxLength": 2000
            },
            "details": {}
          },
          "description": "Error payload: REST error responses and failed realtime responses."
        },
        "agent": {
          "type": "string",
          "maxLength": 128
        }
      }
    }
  ],
  "description": "What an engine agent reports for a job; result is checked against the kind."
}
