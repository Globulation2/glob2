{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:EquipSkinRequest",
  "title": "EquipSkinRequest",
  "type": "object",
  "required": [
    "versionId"
  ],
  "properties": {
    "versionId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "Lowercase UUID."
        },
        {
          "type": "null"
        }
      ]
    },
    "buildingColor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16777215
    }
  },
  "additionalProperties": false
}
