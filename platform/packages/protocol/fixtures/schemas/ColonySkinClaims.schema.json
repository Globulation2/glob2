{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:ColonySkinClaims",
  "title": "ColonySkinClaims",
  "type": "object",
  "required": [
    "iss",
    "aud",
    "sub",
    "iat",
    "exp",
    "matchId",
    "team",
    "accountId",
    "version",
    "buildingColor"
  ],
  "properties": {
    "iss": {
      "type": "string"
    },
    "aud": {
      "type": "string",
      "const": "glob2-colony-renderer"
    },
    "sub": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "iat": {
      "type": "integer",
      "minimum": 0
    },
    "exp": {
      "type": "integer",
      "minimum": 0
    },
    "matchId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "team": {
      "type": "integer",
      "minimum": 0,
      "maximum": 11
    },
    "accountId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "version": {
      "type": "object",
      "required": [
        "id",
        "skinId",
        "textureSha256",
        "manifestSha256",
        "layout",
        "buildingColor",
        "swarmMesh"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "Lowercase UUID."
        },
        "skinId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "Lowercase UUID."
        },
        "textureSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase hexadecimal SHA-256 digest."
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase hexadecimal SHA-256 digest."
        },
        "layout": {
          "type": "string",
          "const": "colony-v1"
        },
        "buildingColor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777215
        },
        "swarmMesh": {
          "anyOf": [
            {
              "type": "string",
              "const": "classic"
            },
            {
              "type": "string",
              "const": "crown"
            },
            {
              "type": "string",
              "const": "clutch"
            },
            {
              "type": "string",
              "const": "toadstool"
            },
            {
              "type": "string",
              "const": "coral"
            },
            {
              "type": "string",
              "const": "skep"
            },
            {
              "type": "string",
              "const": "bloom"
            }
          ]
        }
      }
    },
    "buildingColor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16777215
    }
  }
}
