{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:MusicBatch",
  "title": "MusicBatch",
  "type": "object",
  "required": [
    "ids"
  ],
  "properties": {
    "ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "description": "Lowercase UUID."
      },
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
