{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:HiveContext",
  "title": "HiveContext",
  "type": "object",
  "required": [
    "matchId",
    "seat"
  ],
  "properties": {
    "matchId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "seat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 11
    }
  },
  "additionalProperties": false
}
