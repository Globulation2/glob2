{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:RelayRegistrationResponse",
  "title": "RelayRegistrationResponse",
  "type": "object",
  "required": [
    "relayId",
    "heartbeatIntervalSeconds",
    "jwksUrl"
  ],
  "properties": {
    "relayId": {
      "type": "string"
    },
    "heartbeatIntervalSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "jwksUrl": {
      "type": "string",
      "pattern": "^(https|wss|http|ws)://[^\\s]+$",
      "maxLength": 2048
    }
  }
}
