{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:ValidateMapResult",
  "title": "ValidateMapResult",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "valid",
        "mapHash",
        "map",
        "versionMinor"
      ],
      "properties": {
        "valid": {
          "type": "boolean",
          "const": true
        },
        "mapHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase hexadecimal SHA-256 digest."
        },
        "map": {
          "type": "object",
          "required": [
            "width",
            "height",
            "teamCount"
          ],
          "properties": {
            "setCredits": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "setId",
                  "versionId",
                  "title",
                  "license",
                  "authors",
                  "sourceHash",
                  "entries"
                ],
                "properties": {
                  "setId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                    "description": "Lowercase UUID."
                  },
                  "versionId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                    "description": "Lowercase UUID."
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "\\S"
                  },
                  "license": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "CC0-1.0"
                      },
                      {
                        "type": "string",
                        "const": "CC-BY-4.0"
                      }
                    ]
                  },
                  "authors": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "author",
                        "license"
                      ],
                      "properties": {
                        "author": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "\\S"
                        },
                        "source": {
                          "type": "string",
                          "maxLength": 2000
                        },
                        "license": {
                          "anyOf": [
                            {
                              "type": "string",
                              "const": "CC0-1.0"
                            },
                            {
                              "type": "string",
                              "const": "CC-BY-4.0"
                            }
                          ]
                        }
                      },
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "maxItems": 64
                  },
                  "sourceHash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$",
                    "description": "Lowercase hexadecimal SHA-256 digest."
                  },
                  "entries": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "maxItems": 32768
                  }
                },
                "additionalProperties": false
              },
              "maxItems": 256
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "teamCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "buildingCatalog": {
              "type": "object",
              "required": [
                "snapshot",
                "hash"
              ],
              "properties": {
                "snapshot": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8388608
                },
                "hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "description": "Lowercase hexadecimal SHA-256 digest."
                }
              },
              "additionalProperties": false
            },
            "resourceExperiments": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "label",
                  "help"
                ],
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "help": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "additionalProperties": false
              },
              "maxItems": 64
            },
            "requiredResourceExperiments": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 64
            }
          }
        },
        "versionMinor": {
          "type": "integer",
          "minimum": 0,
          "description": "Format version the file was saved with."
        },
        "title": {
          "type": "string",
          "maxLength": 128
        },
        "players": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "team",
              "kind"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 64
              },
              "team": {
                "type": "integer",
                "minimum": 0,
                "maximum": 11
              },
              "kind": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "human"
                  },
                  {
                    "type": "string",
                    "const": "ai"
                  }
                ]
              }
            }
          },
          "maxItems": 12,
          "description": "Saves only: the players recorded in the file, for reteaming."
        }
      }
    },
    {
      "type": "object",
      "required": [
        "valid",
        "reason"
      ],
      "properties": {
        "valid": {
          "type": "boolean",
          "const": false
        },
        "reason": {
          "type": "string",
          "maxLength": 2000
        }
      }
    }
  ]
}
