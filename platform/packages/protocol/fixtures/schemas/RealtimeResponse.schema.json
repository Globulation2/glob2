{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:RealtimeResponse",
  "title": "RealtimeResponse",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "type",
        "id",
        "ok",
        "result"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "response"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "result": {
          "type": "object",
          "properties": {}
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "id",
        "ok",
        "error"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "response"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "ok": {
          "type": "boolean",
          "const": false
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "bad_request"
                },
                {
                  "type": "string",
                  "const": "unauthenticated"
                },
                {
                  "type": "string",
                  "const": "forbidden"
                },
                {
                  "type": "string",
                  "const": "access_denied"
                },
                {
                  "type": "string",
                  "const": "not_found"
                },
                {
                  "type": "string",
                  "const": "conflict"
                },
                {
                  "type": "string",
                  "const": "rate_limited"
                },
                {
                  "type": "string",
                  "const": "update_required"
                },
                {
                  "type": "string",
                  "const": "unsupported"
                },
                {
                  "type": "string",
                  "const": "unavailable"
                },
                {
                  "type": "string",
                  "const": "internal"
                }
              ]
            },
            "message": {
              "type": "string",
              "maxLength": 2000
            },
            "details": {},
            "messageKey": {
              "type": "string",
              "maxLength": 2000
            },
            "messageParams": {
              "type": "object",
              "patternProperties": {
                "^.*$": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    }
                  ]
                }
              }
            }
          },
          "description": "Error payload: REST error responses and failed realtime responses."
        }
      }
    }
  ],
  "description": "Server response envelope, correlated to a request by id."
}
