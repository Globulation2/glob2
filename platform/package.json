{
  "name": "glob2-platform",
  "private": true,
  "type": "module",
  "description": "Globulation 2 online platform: accounts, rooms, matches, ratings and maps.",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json && tsc -p apps/web/e2e/tsconfig.json",
    "test": "vitest run",
    "fixtures": "npm run --workspace @glob2/protocol generate",
    "migrate": "npm run --workspace @glob2/db migrate --",
    "platform": "node apps/api/src/cli.ts",
    "check": "npm run lint && npm run typecheck && npm run i18n:check && npm test",
    "i18n:browser": "node packages/i18n/scripts/build-browser.ts",
    "i18n:check": "node packages/i18n/scripts/check.ts && node packages/i18n/scripts/build-browser.ts --check",
    "design:sync": "node scripts/design-system.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@glob2/design-system": "git+https://github.com/Globulation2/glob2-design-system.git#acd277710acfebf528e1fc6f653d55fdf75de4b2"
  }
}
