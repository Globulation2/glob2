+    size_t Sprite::measureHighResolutionPending(size_t *wanted)
+    {
+        size_t pending = pendingHighResolution.size(), want = 0;
+        for (auto &[sprite, stream] : deferredHighResolution) { want += stream.wanted.size(); for (unsigned f : stream.wanted) if (!stream.completed.contains(f)) ++pending; }
