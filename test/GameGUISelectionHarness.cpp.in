// SPDX-License-Identifier: GPL-3.0-or-later
// Focused lifetime regression: compile the production selection methods with
// minimal entity/GUI stubs. This does not exercise the interactive event loop.
#include <cassert>
#include <cstdint>
#include <cstdio>
#include <map>
#include <variant>

using Uint16 = uint16_t;
using Sint32 = int32_t;
constexpr int NO_RES_TYPE = -1;

struct Building
{
	static constexpr int MAX_COUNT = 8;
	Uint16 gid;
	int typeNum;
	static int GIDtoID(Uint16 gid) { return gid % MAX_COUNT; }
	static int GIDtoTeam(Uint16 gid) { return gid / MAX_COUNT; }
};
struct Unit : Building {};
struct Team
{
	Building* myBuildings[Building::MAX_COUNT]{};
	Unit* myUnits[Unit::MAX_COUNT]{};
};
struct Resource { int type = NO_RES_TYPE; };
struct Map { Resource getRessource(int) { return {}; } };
struct Game { Team* teams[2]; Map map; };
struct BuildingTypes { int getTypeNum(const char*, int, bool) { return 1; } };
struct GlobalContainer { BuildingTypes buildingsTypes; } globals;
GlobalContainer* globalContainer = &globals;
struct ToolManager { const char* getBuildingName() { return "test"; } };

struct GameGUI
{
	enum SelectionMode { NO_SELECTION, BUILDING_SELECTION, UNIT_SELECTION,
	                     RESSOURCE_SELECTION, TOOL_SELECTION };
	SelectionMode selectionMode = NO_SELECTION;
	std::variant<std::monostate, Building*, Unit*, int> selection;
	struct View { Building* selectedBuilding = nullptr; Unit* selectedUnit = nullptr; } view;
	Team local, foreign;
	Game game{{&local, &foreign}, {}};
	int localTeamNo = 0;
	int centers = 0;
	ToolManager toolManager;
	std::map<Uint16, int> buildingGuiState;
	Building* selectionBuilding() const { return std::get<Building*>(selection); }
	Unit* selectionUnit() const { return std::get<Unit*>(selection); }
	int selectionRessource() const { return std::get<int>(selection); }
	void clearSelection()
	{
		selectionMode = NO_SELECTION;
		selection = std::monostate{};
		view = {};
	}
	void setSelection(SelectionMode mode, Building* b)
	{
		selectionMode = mode; selection = b; view.selectedBuilding = b;
	}
	void setSelection(SelectionMode mode, Unit* u)
	{
		selectionMode = mode; selection = u; view.selectedUnit = u;
	}
	void centerViewportOnSelection() { ++centers; }
	void checkSelection();
	void iterateSelection();
	void onBuildingDestroyed(Building* b);
	void onUnitDestroyed(Unit* u);
};

@PRODUCTION_METHODS@

int main()
{
	// Match Team::syncStep's destruction ordering. Do not draw/check selection
	// between deletion and cycling: the payload must still hold the dead pointer.
	{
		GameGUI gui;
		auto* b = new Building{2, 1};
		gui.local.myBuildings[2] = b;
		gui.setSelection(GameGUI::BUILDING_SELECTION, b);
		gui.onBuildingDestroyed(b);
		gui.local.myBuildings[2] = nullptr;
		assert(gui.selectionBuilding() == b && !gui.view.selectedBuilding);
		delete b;
		gui.iterateSelection();
		assert(gui.selectionMode == GameGUI::NO_SELECTION && gui.centers == 0);
		assert(std::holds_alternative<std::monostate>(gui.selection));
	}
	{
		GameGUI gui;
		auto* u = new Unit{{2, 1}};
		gui.local.myUnits[2] = u;
		gui.setSelection(GameGUI::UNIT_SELECTION, u);
		gui.onUnitDestroyed(u);
		gui.local.myUnits[2] = nullptr;
		assert(gui.selectionUnit() == u && !gui.view.selectedUnit);
		delete u;
		gui.iterateSelection();
		assert(gui.selectionMode == GameGUI::NO_SELECTION && gui.centers == 0);
		assert(std::holds_alternative<std::monostate>(gui.selection));
	}
	{
		GameGUI gui;
		gui.iterateSelection();
		gui.setSelection(GameGUI::BUILDING_SELECTION, static_cast<Building*>(nullptr));
		gui.iterateSelection();
		assert(gui.selectionMode == GameGUI::NO_SELECTION);
		gui.setSelection(GameGUI::UNIT_SELECTION, static_cast<Unit*>(nullptr));
		gui.iterateSelection();
		assert(gui.selectionMode == GameGUI::NO_SELECTION && gui.centers == 0);
	}
	{
		GameGUI gui;
		Building first{1, 1}, last{7, 1}, otherType{0, 2}, foreign{9, 1};
		gui.local.myBuildings[0] = &otherType;
		gui.local.myBuildings[1] = &first;
		gui.local.myBuildings[7] = &last;
		gui.setSelection(GameGUI::BUILDING_SELECTION, &first);
		gui.iterateSelection();
		assert(gui.selectionBuilding() == &last && gui.centers == 1);
		gui.iterateSelection();
		assert(gui.selectionBuilding() == &first && gui.centers == 2);
		gui.setSelection(GameGUI::BUILDING_SELECTION, &foreign);
		gui.iterateSelection();
		assert(gui.selectionBuilding() == &foreign && gui.centers == 2);
		gui.clearSelection();
		gui.selectionMode = GameGUI::TOOL_SELECTION;
		gui.iterateSelection();
		assert(gui.selectionBuilding() == &first && gui.centers == 3);
	}
	{
		GameGUI gui;
		Unit first{{1, 1}}, last{{7, 1}}, otherType{{0, 2}};
		gui.local.myUnits[0] = &otherType;
		gui.local.myUnits[1] = &first;
		gui.local.myUnits[7] = &last;
		gui.setSelection(GameGUI::UNIT_SELECTION, &first);
		gui.iterateSelection();
		assert(gui.selectionUnit() == &last && gui.centers == 1);
		gui.iterateSelection();
		assert(gui.selectionUnit() == &first && gui.centers == 2);
		gui.local.myUnits[7] = nullptr;
		gui.iterateSelection();
		assert(gui.selectionUnit() == &first && gui.centers == 2);
	}
	std::puts("GameGUI selection lifetime and cycling regressions passed");
}
