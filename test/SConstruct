import sys

env = Environment()
if "CXX" in ARGUMENTS:
  env["CXX"] = ARGUMENTS["CXX"]

if sys.platform.startswith("linux"):
  ccflags = '-Wall -g'
else:
  ccflags = '/EHsc /MD /GR'

env.Append(CCFLAGS = ccflags)

sources = Split("""
TestsRunner.cpp

PerlinNoiseTest.cpp
../src/PerlinNoise.cpp

HelloWorldTest.cpp

natsort/NatSortTest.cpp
""")


env.Append(LIBS=['cppunit'])

env.Program( sources )

