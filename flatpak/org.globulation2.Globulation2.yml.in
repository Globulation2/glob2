app-id: org.globulation2.Globulation2
runtime: org.gnome.Platform
runtime-version: '51'
sdk: org.gnome.Sdk
command: glob2
rename-icon: glob2
finish-args:
  - --share=ipc
  - --share=network
  - --socket=wayland
  - --socket=fallback-x11
  - --socket=pulseaudio
  - --device=dri
modules:
  - name: scons
    buildsystem: simple
    build-commands:
      - python3 setup.py install --prefix=/app
    sources:
      - type: archive
        url: https://files.pythonhosted.org/packages/source/s/scons/scons-4.8.1.tar.gz
        sha256: 5b641357904d2f56f7bfdbb37e165ab996b6143c948b9df0efc7305f54949daa

  - name: libogg
    buildsystem: autotools
    sources:
      - type: archive
        url: https://github.com/xiph/ogg/releases/download/v1.3.6/libogg-1.3.6.tar.gz
        sha256: 83e6704730683d004d20e21b8f7f55dcb3383cdf84c0daedf30bde175f774638

  - name: libvorbis
    buildsystem: autotools
    sources:
      - type: archive
        url: https://downloads.xiph.org/releases/vorbis/libvorbis-1.3.7.tar.gz
        sha256: 0e982409a9c3fc82ee06e08205b1355e5c6aa4c36bca58146ef399621b0ce5ab

  - name: speex
    buildsystem: autotools
    sources:
      - type: archive
        url: https://downloads.xiph.org/releases/speex/speex-1.2.1.tar.gz
        sha256: 4b44d4f2b38a370a2d98a78329fefc56a0cf93d1c1be70029217baae6628feea

  # Also supplies the pinned build-time encoder used by runtime asset export.
  - name: libwebp
    buildsystem: cmake-ninja
    builddir: true
    config-opts:
      - -DBUILD_SHARED_LIBS=ON
      - -DWEBP_BUILD_EXTRAS=OFF
    sources:
      - type: archive
        url: https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-1.6.0.tar.gz
        sha256: e4ab7009bf0629fd11982d4c2aa83964cf244cffba7347ecd39019a9e38c4564

  - name: setuptools-build-tool
    buildsystem: simple
    build-commands:
      - export PYTHONPATH="/app/lib/python$(python3 -c 'import sys; print(str(sys.version_info.major)+"."+str(sys.version_info.minor))')/site-packages${PYTHONPATH:+:$PYTHONPATH}"; python3 -m pip install --no-index --no-build-isolation --no-deps --prefix=/app .
    cleanup:
      - /lib/python*/site-packages/setuptools*
      - /lib/python*/site-packages/_distutils_hack
      - /lib/python*/site-packages/pkg_resources
      - /lib/python*/site-packages/distutils-precedence.pth
    sources:
      - type: archive
        url: https://files.pythonhosted.org/packages/18/5d/3bf57dcd21979b887f014ea83c24ae194cfcd12b9e0fda66b957c69d1fca/setuptools-80.9.0.tar.gz
        sha256: f36b47402ecde768dbfafc46e8e4207b4360c654f1f3bb84475f0a28628fb19c

  - name: pybind11-build-tool
    buildsystem: simple
    # Pillow needs only this header-only project's Python build helpers/headers.
    # Installing the source directly avoids scikit-build-core in the sandbox.
    build-commands:
      - site="/app/lib/python$(python3 -c 'import sys; print(str(sys.version_info.major)+"."+str(sys.version_info.minor))')/site-packages"; mkdir -p "$site"; cp -a pybind11 "$site/"; cp -a include "$site/pybind11/"
    cleanup:
      - /lib/python*/site-packages/pybind11*
      - /lib/python*/site-packages/_distutils_hack
      - /lib/python*/site-packages/pkg_resources
      - /lib/python*/site-packages/distutils-precedence.pth
    sources:
      - type: archive
        url: https://files.pythonhosted.org/packages/a5/98/9118a0659646f1628c592ef9bb48e0056efa6bf27c951fd12a178e0136fb/pybind11-3.0.2.tar.gz
        sha256: 432f01aeb68e361a3a7fc7575c2c7f497595bf640f747acd909ff238dd766e06

  - name: pillow-build-tool
    buildsystem: simple
    build-commands:
      - export PYTHONPATH="/app/lib/python$(python3 -c 'import sys; print(str(sys.version_info.major)+"."+str(sys.version_info.minor))')/site-packages${PYTHONPATH:+:$PYTHONPATH}"; python3 -m pip install --no-index --no-build-isolation --no-deps --prefix=/app .
    cleanup:
      - /lib/python*/site-packages/PIL
      - /lib/python*/site-packages/pillow*
    sources:
      - type: archive
        url: https://files.pythonhosted.org/packages/8c/21/c2bcdd5906101a30244eaffc1b6e6ce71a31bd0742a01eb89e660ebfac2d/pillow-12.2.0.tar.gz
        sha256: a830b1a40919539d07806aa58e1b114df53ddd43213d9c8b75847eee6c0182b5

  - name: SDL3
    buildsystem: cmake-ninja
    builddir: true
    config-opts:
      - -DSDL_TESTS=OFF
      - -DSDL_TEST_LIBRARY=OFF
    sources:
      - type: archive
        url: https://github.com/libsdl-org/SDL/releases/download/release-3.4.16/SDL3-3.4.16.tar.gz
        sha256: 7322236cd12090c3eb40b9728be4d49c76f66ad17d04369584d4ecad5cf77c68

  - name: SDL3_image
    buildsystem: cmake-ninja
    builddir: true
    config-opts:
      - -DSDLIMAGE_ANI=OFF
      - -DSDLIMAGE_AVIF=OFF
      - -DSDLIMAGE_BMP=OFF
      - -DSDLIMAGE_GIF=OFF
      - -DSDLIMAGE_JPG=ON
      - -DSDLIMAGE_JXL=OFF
      - -DSDLIMAGE_LBM=OFF
      - -DSDLIMAGE_PCX=OFF
      - -DSDLIMAGE_PNG=ON
      - -DSDLIMAGE_PNM=OFF
      - -DSDLIMAGE_QOI=OFF
      - -DSDLIMAGE_SVG=OFF
      - -DSDLIMAGE_TGA=OFF
      - -DSDLIMAGE_TIF=OFF
      - -DSDLIMAGE_WEBP=ON
      - -DSDLIMAGE_XCF=OFF
      - -DSDLIMAGE_XPM=OFF
      - -DSDLIMAGE_XV=OFF
      - -DBUILD_SHARED_LIBS=ON
      - -DSDLIMAGE_DEPS_SHARED=OFF
      - -DSDLIMAGE_STRICT=ON
      - -DSDLIMAGE_BACKEND_STB=OFF
      - -DSDLIMAGE_BACKEND_IMAGEIO=OFF
      - -DSDLIMAGE_SAMPLES=OFF
      - -DSDLIMAGE_TESTS=OFF
      - -DCMAKE_BUILD_TYPE=Release
      - -DSDLIMAGE_PNG_SAVE=ON
      - -DSDLIMAGE_JPG_SAVE=ON
      - -DSDLIMAGE_WEBP_SAVE=OFF
    sources:
      - type: archive
        url: https://github.com/libsdl-org/SDL_image/releases/download/release-3.4.6/SDL3_image-3.4.6.tar.gz
        sha256: d2e4637ae700f72e5196b8fbd749850ed2e5e1e09c5a5be8d06ff55aaccf3b01

  - name: SDL3_ttf
    buildsystem: cmake-ninja
    builddir: true
    config-opts:
      - -DSDLTTF_SAMPLES=OFF
      - -DSDLTTF_HARFBUZZ=OFF
    sources:
      - type: archive
        url: https://github.com/libsdl-org/SDL_ttf/releases/download/release-3.2.2/SDL3_ttf-3.2.2.tar.gz
        sha256: 63547d58d0185c833213885b635a2c0548201cc8f301e6587c0be1a67e1e045d

  - name: SDL3_net
    buildsystem: cmake-ninja
    builddir: true
    config-opts:
      - -DSDLNET_SAMPLES=OFF
    sources:
      - type: archive
        url: https://github.com/libsdl-org/SDL_net/releases/download/release-3.2.0/SDL3_net-3.2.0.tar.gz
        sha256: 098522fc26d4e302ef9348aee6e76e67fe504dfefd7f596236568f8330570c41

  - name: glu
    buildsystem: meson
    sources:
      - type: archive
        url: https://archive.mesa3d.org/glu/glu-9.0.3.tar.xz
        sha256: bd43fe12f374b1192eb15fe20e45ff456b9bc26ab57f0eee919f96ca0f8a330f

  - name: libepoxy
    buildsystem: meson
    sources:
      - type: archive
        url: https://download.gnome.org/sources/libepoxy/1.5/libepoxy-1.5.10.tar.xz
        sha256: 072cda4b59dd098bba8c2363a6247299db1fa89411dc221c8b81b8ee8192e623

  - name: boost-headers
    buildsystem: simple
    build-commands:
      - cp -a boost /app/include/
    sources:
      - type: archive
        url: https://archives.boost.io/release/1.86.0/source/boost_1_86_0.tar.gz
        sha256: 2575e74ffc3ef1cd0babac2c1ee8bdb5782a0ee672b1912da40e5b4b591ca01f

  - name: glob2
    buildsystem: simple
    build-commands:
      - export PYTHONPATH="/app/lib/python$(python3 -c 'import sys; print(str(sys.version_info.major)+"."+str(sys.version_info.minor))')/site-packages${PYTHONPATH:+:$PYTHONPATH}"; scons -j2 release=1 server=0 CXXFLAGS="-I/app/include -I/app/include/SDL3" LINKFLAGS=-L/app/lib BINDIR=/app/bin INSTALLDIR=/app/share DATADIR=/app/share install
      - test -f /app/share/metainfo/org.globulation2.Globulation2.metainfo.xml
      - test -f /app/share/glob2/data/maxima/duel.strategy
      - test -f /app/share/glob2/data/usl/Language/Runtime/Control.usl
    sources:
      - type: git
        url: https://github.com/Globulation2/glob2.git
        commit: RELEASE_COMMIT
      - type: file
        url: https://ffmpeg.org/releases/ffmpeg-8.0.tar.xz
        sha256: b2751fccb6cc4c77708113cd78b561059b6fa904b24162fa0be2d60273d27b8e
        dest: third_party/recording-sources
        dest-filename: ffmpeg-8.0.tar.xz
      - type: file
        url: https://codeload.github.com/FFmpeg/nv-codec-headers/tar.gz/refs/tags/n13.0.19.0
        sha256: 86d15d1a7c0ac73a0eafdfc57bebfeba7da8264595bf531cf4d8db1c22940116
        dest: third_party/recording-sources
        dest-filename: nv-codec-headers-13.0.19.0.tar.gz
      - type: file
        url: https://codeload.github.com/mirror/x264/tar.gz/0480cb05fa188d37ae87e8f4fd8f1aea3711f7ee
        sha256: d0967a1348c85dfde363bb52610403be898171493100561efa0dd05d5fd1ae50
        dest: third_party/recording-sources
        dest-filename: x264-0480cb05.tar.gz
