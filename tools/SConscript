import os
    
if "mksprite" in COMMAND_LINE_TARGETS:
    env = Environment()
    env.ParseConfig("Magick++-config --cxxflags --cppflags")
    env.ParseConfig("Magick++-config --ldflags --libs")
    env.Program("mksprite", "mksprite.cpp")
    
Import("env")
Import("PackTar")
    
if 'dist' in COMMAND_LINE_TARGETS or 'install' in COMMAND_LINE_TARGETS:
    PackTar(env["TARFILE"], ["package_assets.py", "asset-requirements.txt", "asset-encoder-sources.json", "build_asset_encoder.py"])
    PackTar(env["TARFILE"], "mksprite.cpp")
    PackTar(env["TARFILE"], "MenuColonyHarness.cpp")
    PackTar(env["TARFILE"], "README")
    
    PackTar(env["TARFILE"], "SConscript")
    
