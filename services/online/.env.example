# Copy to .env (ignored by git) and adjust. Variables already set in the
# environment take precedence over this file.

# Postgres connection used by every service.
DATABASE_URL=postgres://glob2:glob2@127.0.0.1:5432/glob2

# Origin players reach the instance at (no trailing slash).
PUBLIC_ORIGIN=http://localhost:8080

# api listen address.
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Blob storage: fs (directory, default) or s3 (not implemented yet).
BLOB_STORE=fs
BLOB_DIR=data/blobs

# Path to instance settings (default ./instance.yaml; built-in defaults if absent).
# INSTANCE_CONFIG=instance.yaml

# Seconds to finish in-flight work after SIGTERM.
SHUTDOWN_GRACE_SECONDS=25

# engine-agent only (see docs/multiplayer/architecture.md, "Engine agents").
# The glob2 binary and the directory holding its data/:
# ENGINE_BINARY=/opt/glob2/bin/glob2
# ENGINE_WORKDIR=/opt/glob2/share/glob2
# The sim data hash, until the binary reports it itself (or a full sim version
# key, checked against the binary's VERSION_MINOR and NET_PROTOCOL_VERSION):
# ENGINE_DATA_HASH=<64 hex digits>
# ENGINE_SIM_VERSION=125-49-<64 hex digits>
# ENGINE_BUILD=glob2-0.9.25
# ENGINE_CONCURRENCY=1
# ENGINE_SCRATCH_DIR=/tmp
# Asset-capable (format 144+) binaries require Linux namespace isolation and
# dedicated scratch tmpfs <=4 GiB for map jobs, even with publishing disabled.
# ENGINE_SET_VALIDATION=0
# ENGINE_SET_LIBRARY_PATH=/opt/glob2/lib
# ENGINE_TIMEOUT_GENERATE_S=300
# ENGINE_TIMEOUT_INSPECT_S=120
# ENGINE_TIMEOUT_VERIFY_S=3600
# ENGINE_MEMORY_MB=8192
# ENGINE_MAX_MAP_BYTES=67108864
# ENGINE_MAX_RECORD_BYTES=268435456

# platform-worker only: pre-generated maps kept per queue map pool entry and
# served sim version (0 turns the warm map pool off).
# WARM_MAPS_PER_ENTRY=1

# Ed25519 signing keys for access tokens and match tickets (api). Either a
# directory of <kid>.pem files (`npm run platform -- keys generate --dir keys`),
# or one key inline (PEM, newlines as \n). With several keys, JWT_ACTIVE_KID
# picks the signing key; the others stay in the JWKS for verification. Without
# any key, only a http://localhost instance starts (with a throwaway key).
# JWT_KEYS_DIR=keys
# JWT_ACTIVE_KID=k20261001
# JWT_KEY_ID=k20261001
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Relay keys (api): relays send one as `Authorization: Bearer <key>` on every
# /internal call (relay GLOB2_RELAY_KEY). Comma-separated; `<relayId>:<key>`
# pins a key to one relay id. At least 32 characters each, e.g. from
# `openssl rand -base64 32`. RELAY_KEYS_FILE reads one entry per line instead.
# Without any key, relays cannot register and rooms cannot start matches.
# RELAY_KEYS=relay-eu1:...,relay-us1:...
# RELAY_KEYS_FILE=secrets/relay-keys

# Size limits (bytes) for uploaded maps/saves and relay match records.
# UPLOAD_MAX_BYTES=16777216
# RECORD_MAX_BYTES=67108864

# Secrets referenced from instance.yaml by name, e.g.
# GOOGLE_CLIENT_SECRET=...

# Tests: a Postgres role allowed to CREATE DATABASE.
# TEST_DATABASE_URL=postgres://glob2:glob2@127.0.0.1:55432/postgres

# AI coding Studio (aiStudio settings in instance.yaml). Never exposed to browsers.
# AI_STUDIO_OPENAI_API_KEY=
# AI_STUDIO_STRIPE_SECRET_KEY=
# AI_STUDIO_STRIPE_WEBHOOK_SECRET=
