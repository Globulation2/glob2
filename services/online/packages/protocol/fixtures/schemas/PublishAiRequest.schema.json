{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:PublishAiRequest",
  "title": "PublishAiRequest",
  "type": "object",
  "required": [
    "uploadId",
    "name",
    "description",
    "tags",
    "visibility",
    "version",
    "notes"
  ],
  "properties": {
    "uploadId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "tags": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "const": "Balanced"
          },
          {
            "type": "string",
            "const": "Rush"
          },
          {
            "type": "string",
            "const": "Defensive"
          },
          {
            "type": "string",
            "const": "Economy"
          },
          {
            "type": "string",
            "const": "Expansion"
          },
          {
            "type": "string",
            "const": "Experimental"
          },
          {
            "type": "string",
            "const": "Beginner-friendly"
          }
        ]
      },
      "maxItems": 5,
      "uniqueItems": true
    },
    "visibility": {
      "anyOf": [
        {
          "type": "string",
          "const": "public"
        },
        {
          "type": "string",
          "const": "unlisted"
        },
        {
          "type": "string",
          "const": "private"
        }
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "\\S"
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "additionalProperties": false
}
