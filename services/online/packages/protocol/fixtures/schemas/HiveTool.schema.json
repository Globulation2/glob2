{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:HiveTool",
  "title": "HiveTool",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "kind",
        "source"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "execute"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 131072,
          "pattern": "^[^\\u0000]*$"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "kind",
        "program"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "install"
        },
        "program": {
          "type": "object",
          "required": [
            "id",
            "revision",
            "name",
            "description",
            "source",
            "intervalTicks"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "description": "Lowercase UUID."
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "description": {
              "type": "string",
              "maxLength": 512
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 131072,
              "pattern": "^[^\\u0000]*$"
            },
            "intervalTicks": {
              "type": "integer",
              "minimum": 25,
              "maximum": 2147483647
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "kind",
        "program",
        "expectedRevision"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "replace"
        },
        "program": {
          "type": "object",
          "required": [
            "id",
            "revision",
            "name",
            "description",
            "source",
            "intervalTicks"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "description": "Lowercase UUID."
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "description": {
              "type": "string",
              "maxLength": 512
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 131072,
              "pattern": "^[^\\u0000]*$"
            },
            "intervalTicks": {
              "type": "integer",
              "minimum": 25,
              "maximum": 2147483647
            }
          },
          "additionalProperties": false
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "migration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 131072,
          "pattern": "^[^\\u0000]*$"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "list"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "kind",
        "programId",
        "expectedRevision"
      ],
      "properties": {
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "const": "pause"
            },
            {
              "type": "string",
              "const": "resume"
            },
            {
              "type": "string",
              "const": "remove"
            }
          ]
        },
        "programId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "Lowercase UUID."
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "additionalProperties": false
    }
  ]
}
