{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:CrashSessionPing",
  "title": "CrashSessionPing",
  "type": "object",
  "required": [
    "schema",
    "installId",
    "version",
    "versionMinor",
    "distribution",
    "platform",
    "day",
    "sessions"
  ],
  "properties": {
    "schema": {
      "type": "number",
      "const": 1
    },
    "installId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){2,3}$"
    },
    "versionMinor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "distribution": {
      "anyOf": [
        {
          "type": "string",
          "const": "direct"
        },
        {
          "type": "string",
          "const": "browser"
        },
        {
          "type": "string",
          "const": "steam"
        },
        {
          "type": "string",
          "const": "epic"
        },
        {
          "type": "string",
          "const": "google_play"
        },
        {
          "type": "string",
          "const": "app_store"
        },
        {
          "type": "string",
          "const": "microsoft"
        },
        {
          "type": "string",
          "const": "amazon"
        },
        {
          "type": "string",
          "const": "china"
        }
      ]
    },
    "platform": {
      "anyOf": [
        {
          "type": "string",
          "const": "linux"
        },
        {
          "type": "string",
          "const": "windows"
        },
        {
          "type": "string",
          "const": "macos"
        },
        {
          "type": "string",
          "const": "ios"
        },
        {
          "type": "string",
          "const": "android"
        },
        {
          "type": "string",
          "const": "web"
        },
        {
          "type": "string",
          "const": "other"
        }
      ]
    },
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "sessions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    }
  },
  "additionalProperties": false
}
