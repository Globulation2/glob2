{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:ImportAiMapPayload",
  "title": "ImportAiMapPayload",
  "type": "object",
  "required": [
    "imageHash",
    "settings",
    "seed"
  ],
  "properties": {
    "imageHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase hexadecimal SHA-256 digest."
    },
    "settings": {
      "type": "object",
      "required": [
        "width",
        "height",
        "players"
      ],
      "properties": {
        "width": {
          "anyOf": [
            {
              "type": "number",
              "const": 128
            },
            {
              "type": "number",
              "const": 256
            },
            {
              "type": "number",
              "const": 512
            }
          ]
        },
        "height": {
          "anyOf": [
            {
              "type": "number",
              "const": 128
            },
            {
              "type": "number",
              "const": 256
            },
            {
              "type": "number",
              "const": 512
            }
          ]
        },
        "players": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        }
      },
      "additionalProperties": false
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  },
  "additionalProperties": false
}
