{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:RealtimeEventRoomClosed",
  "title": "RealtimeEventRoomClosed",
  "type": "object",
  "required": [
    "roomId",
    "reason"
  ],
  "properties": {
    "roomId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "const": "host_closed"
        },
        {
          "type": "string",
          "const": "kicked"
        },
        {
          "type": "string",
          "const": "expired"
        }
      ]
    }
  }
}
