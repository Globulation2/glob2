{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:LocalRegisterRequest",
  "title": "LocalRegisterRequest",
  "type": "object",
  "required": [
    "username",
    "password",
    "platform"
  ],
  "properties": {
    "username": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{3,32}$"
    },
    "password": {
      "type": "string",
      "minLength": 10,
      "maxLength": 256
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "description": "Display name; at most 32 UTF-8 bytes (checked semantically)."
    },
    "platform": {
      "anyOf": [
        {
          "type": "string",
          "const": "desktop"
        },
        {
          "type": "string",
          "const": "android"
        },
        {
          "type": "string",
          "const": "ios"
        },
        {
          "type": "string",
          "const": "browser"
        }
      ],
      "description": "Kind of game client."
    }
  },
  "additionalProperties": false
}
