{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:RealtimeEvent",
  "title": "RealtimeEvent",
  "type": "object",
  "required": [
    "type",
    "event",
    "data"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "event"
    },
    "event": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[A-Za-z]+)+$",
      "maxLength": 64
    },
    "data": {
      "type": "object",
      "properties": {}
    }
  },
  "description": "Server event envelope."
}
