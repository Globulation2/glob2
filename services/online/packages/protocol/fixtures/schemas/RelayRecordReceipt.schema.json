{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:RelayRecordReceipt",
  "title": "RelayRecordReceipt",
  "type": "object",
  "required": [
    "matchId",
    "sha256",
    "size"
  ],
  "properties": {
    "matchId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase hexadecimal SHA-256 digest."
    },
    "size": {
      "type": "integer",
      "minimum": 0
    }
  }
}
