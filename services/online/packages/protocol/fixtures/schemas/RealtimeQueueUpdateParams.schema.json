{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:RealtimeQueueUpdateParams",
  "title": "RealtimeQueueUpdateParams",
  "type": "object",
  "required": [
    "ticketId",
    "allowAiOpponent"
  ],
  "properties": {
    "ticketId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "allowAiOpponent": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
