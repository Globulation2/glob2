{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:CrashGroupStateRequest",
  "title": "CrashGroupStateRequest",
  "type": "object",
  "required": [
    "state"
  ],
  "properties": {
    "state": {
      "anyOf": [
        {
          "type": "string",
          "const": "new"
        },
        {
          "type": "string",
          "const": "triaged"
        },
        {
          "type": "string",
          "const": "resolved"
        }
      ]
    },
    "fixedIn": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){2,3}$"
    }
  },
  "additionalProperties": false
}
