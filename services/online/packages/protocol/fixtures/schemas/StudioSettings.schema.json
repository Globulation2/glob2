{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:StudioSettings",
  "title": "StudioSettings",
  "type": "object",
  "required": [
    "width",
    "height",
    "players"
  ],
  "properties": {
    "width": {
      "anyOf": [
        {
          "type": "number",
          "const": 128
        },
        {
          "type": "number",
          "const": 256
        },
        {
          "type": "number",
          "const": 512
        }
      ]
    },
    "height": {
      "anyOf": [
        {
          "type": "number",
          "const": 128
        },
        {
          "type": "number",
          "const": 256
        },
        {
          "type": "number",
          "const": 512
        }
      ]
    },
    "players": {
      "type": "integer",
      "minimum": 2,
      "maximum": 8
    }
  },
  "additionalProperties": false
}
