{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:AiStudioCommand",
  "title": "AiStudioCommand",
  "type": "object",
  "required": [
    "id",
    "expectedRevision",
    "text",
    "budget"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "diagnostics": {
      "type": "string",
      "maxLength": 16000
    },
    "budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    }
  },
  "additionalProperties": false
}
