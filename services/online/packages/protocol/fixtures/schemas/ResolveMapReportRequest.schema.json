{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:ResolveMapReportRequest",
  "title": "ResolveMapReportRequest",
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "anyOf": [
        {
          "type": "string",
          "const": "resolved"
        },
        {
          "type": "string",
          "const": "dismissed"
        }
      ]
    },
    "note": {
      "type": "string",
      "maxLength": 2000
    },
    "hideMap": {
      "type": "boolean",
      "description": "Also hide the reported map."
    },
    "hideReason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "additionalProperties": false
}
