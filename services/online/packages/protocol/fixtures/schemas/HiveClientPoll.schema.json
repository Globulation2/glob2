{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:HiveClientPoll",
  "title": "HiveClientPoll",
  "type": "object",
  "required": [
    "clientId",
    "tick",
    "caughtUp"
  ],
  "properties": {
    "clientId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "lease": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "caughtUp": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
