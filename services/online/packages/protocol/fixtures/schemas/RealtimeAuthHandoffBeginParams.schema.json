{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:RealtimeAuthHandoffBeginParams",
  "title": "RealtimeAuthHandoffBeginParams",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "maxLength": 64
    },
    "mode": {
      "anyOf": [
        {
          "type": "string",
          "const": "link"
        },
        {
          "type": "string",
          "const": "signin"
        }
      ],
      "description": "link (default on an authenticated socket): attach the identity to the current account. signin: switch to the account owning the identity, creating one if new."
    }
  },
  "additionalProperties": false
}
