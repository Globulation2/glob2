{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:AdminRenameRequest",
  "title": "AdminRenameRequest",
  "type": "object",
  "required": [
    "displayName"
  ],
  "properties": {
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "description": "Display name; at most 32 UTF-8 bytes (checked semantically)."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "additionalProperties": false
}
