{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:ResolveSkinReportRequest",
  "title": "ResolveSkinReportRequest",
  "type": "object",
  "required": [
    "resolution",
    "reason"
  ],
  "properties": {
    "resolution": {
      "anyOf": [
        {
          "type": "string",
          "const": "dismissed"
        },
        {
          "type": "string",
          "const": "disabled"
        }
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  },
  "additionalProperties": false
}
