{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:RealtimeQueueRespondParams",
  "title": "RealtimeQueueRespondParams",
  "type": "object",
  "required": [
    "proposalId",
    "accept"
  ],
  "properties": {
    "proposalId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "accept": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
