{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:RenderPreviewPayload",
  "title": "RenderPreviewPayload",
  "type": "object",
  "required": [
    "mapHash",
    "maxSizePx"
  ],
  "properties": {
    "mapHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase hexadecimal SHA-256 digest."
    },
    "maxSizePx": {
      "type": "integer",
      "minimum": 16,
      "maximum": 2048
    }
  },
  "additionalProperties": false
}
