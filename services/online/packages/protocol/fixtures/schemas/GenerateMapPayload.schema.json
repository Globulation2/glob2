{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:GenerateMapPayload",
  "title": "GenerateMapPayload",
  "type": "object",
  "required": [
    "generator"
  ],
  "properties": {
    "generator": {
      "type": "object",
      "required": [
        "generatorId",
        "revision",
        "params",
        "seed",
        "candidates",
        "startingUnitLevel"
      ],
      "properties": {
        "generatorId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "description": "GeneratorDefinition::id, e.g. \"even-ground\"."
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "params": {
          "type": "object",
          "patternProperties": {
            "^[A-Za-z0-9_-]{1,64}$": {
              "type": "integer"
            }
          },
          "description": "Every control value by GeneratorControl::id, including the shared \"width\" and \"height\" (log2 of the size), \"teams\" and \"workers\"."
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "description": "Number of seeded rolls; the best-scoring one is kept (GenerationService::bestSeed)."
        },
        "startingUnitLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "Level the generated starting workers spawn at (0 = standard)."
        }
      },
      "additionalProperties": false,
      "description": "Deterministic description of a generated map."
    }
  },
  "additionalProperties": false
}
