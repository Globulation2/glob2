{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:RoomList",
  "title": "RoomList",
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "code",
          "name",
          "hostDisplayName",
          "simVersion",
          "status",
          "seatsTotal",
          "seatsTaken"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "description": "Lowercase UUID."
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{6,16}$"
          },
          "name": {
            "type": "string",
            "maxLength": 64
          },
          "hostDisplayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
            "description": "Display name; at most 32 UTF-8 bytes (checked semantically)."
          },
          "simVersion": {
            "type": "object",
            "required": [
              "versionMinor",
              "netProtocol",
              "dataHash"
            ],
            "properties": {
              "versionMinor": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535,
                "description": "VERSION_MINOR in src/app/Version.h (save and simulation format)."
              },
              "netProtocol": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535,
                "description": "NET_PROTOCOL_VERSION in src/app/Version.h."
              },
              "dataHash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "Lowercase hex SHA-256 over the build's simulation data files, as computed by the engine."
              }
            },
            "additionalProperties": false,
            "description": "Identity of a deterministic simulation build."
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "const": "open"
              },
              {
                "type": "string",
                "const": "starting"
              },
              {
                "type": "string",
                "const": "in_match"
              },
              {
                "type": "string",
                "const": "closed"
              }
            ]
          },
          "seatsTotal": {
            "type": "integer",
            "minimum": 0
          },
          "seatsTaken": {
            "type": "integer",
            "minimum": 0
          },
          "mapTitle": {
            "type": "string",
            "maxLength": 128
          },
          "mapPreviewUrl": {
            "type": "string",
            "pattern": "^(https|wss|http|ws)://[^\\s]+$",
            "maxLength": 2048
          }
        }
      }
    },
    "nextCursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "description": "Public rooms that can be joined."
}
