{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:RelayRegistration",
  "title": "RelayRegistration",
  "type": "object",
  "required": [
    "relayId",
    "publicUrl",
    "region",
    "build",
    "turnProtocol",
    "capacity",
    "load",
    "draining"
  ],
  "properties": {
    "relayId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "publicUrl": {
      "type": "string",
      "pattern": "^(https|wss|http|ws)://[^\\s]+$",
      "maxLength": 2048
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
      "description": "Operator-chosen region id, e.g. \"eu-west\"."
    },
    "build": {
      "type": "string",
      "maxLength": 128,
      "description": "Relay build identifier."
    },
    "turnProtocol": {
      "type": "integer",
      "minimum": 1,
      "description": "Binary turn-protocol version (docs/multiplayer/turn-protocol.md)."
    },
    "capacity": {
      "type": "object",
      "required": [
        "maxMatches"
      ],
      "properties": {
        "maxMatches": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "load": {
      "type": "object",
      "required": [
        "matches",
        "connections"
      ],
      "properties": {
        "matches": {
          "type": "integer",
          "minimum": 0
        },
        "connections": {
          "type": "integer",
          "minimum": 0
        },
        "cpu": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of capacity."
        }
      },
      "additionalProperties": false
    },
    "draining": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "description": "Relay start-up registration."
}
