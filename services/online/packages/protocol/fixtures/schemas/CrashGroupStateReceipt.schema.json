{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:CrashGroupStateReceipt",
  "title": "CrashGroupStateReceipt",
  "type": "object",
  "required": [
    "id",
    "state"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID."
    },
    "state": {
      "anyOf": [
        {
          "type": "string",
          "const": "new"
        },
        {
          "type": "string",
          "const": "triaged"
        },
        {
          "type": "string",
          "const": "resolved"
        }
      ]
    },
    "fixedIn": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){2,3}$"
    }
  },
  "additionalProperties": false
}
