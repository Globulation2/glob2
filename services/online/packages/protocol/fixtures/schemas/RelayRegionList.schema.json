{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:RelayRegionList",
  "title": "RelayRegionList",
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "region",
          "probeUrl",
          "relays"
        ],
        "properties": {
          "region": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
            "description": "Operator-chosen region id, e.g. \"eu-west\"."
          },
          "probeUrl": {
            "type": "string",
            "pattern": "^(https|wss|http|ws)://[^\\s]+$",
            "maxLength": 2048
          },
          "relays": {
            "type": "integer",
            "minimum": 1,
            "description": "Available relays in the region."
          }
        }
      },
      "maxItems": 32
    }
  },
  "description": "Regions with an available relay, by region id."
}
