{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:RealtimeRoomJoinParams",
  "title": "RealtimeRoomJoinParams",
  "type": "object",
  "required": [
    "code"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{6,16}$"
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "region",
          "rttMs"
        ],
        "properties": {
          "region": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
            "description": "Operator-chosen region id, e.g. \"eu-west\"."
          },
          "rttMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000
          }
        },
        "additionalProperties": false
      },
      "maxItems": 32,
      "description": "Measured round trip to each relay region."
    }
  },
  "additionalProperties": false
}
