{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glob2-protocol:GeneratorStudioSave",
  "title": "GeneratorStudioSave",
  "type": "object",
  "required": [
    "expectedRevision"
  ],
  "properties": {
    "expectedRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 262144
    },
    "restoreRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "const": "manual"
        },
        {
          "type": "string",
          "const": "import"
        }
      ]
    }
  },
  "additionalProperties": false
}
