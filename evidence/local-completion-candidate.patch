+    auto batch=executor.submit(std::span(&jobs,1));
+    std::atomic<bool> entered{false},release{false},timedOut{false};
+    auto presentation=executor.submitPresentation(1,[&](std::size_t){
+        entered=true; while(!release.load()) std::this_thread::yield();
+    });
+    // Worker slot two is designated for presentation. Its queue contains
+    // required records before it reaches the eight-claim optional opportunity.
+    auto& designated=a.slot==2 ? a : b;
+    auto& spare=a.slot==2 ? b : a;
+    designated.open=true;
+    deadline=std::chrono::steady_clock::now()+std::chrono::seconds(5);
+    while(!entered && std::chrono::steady_clock::now()<deadline) std::this_thread::yield();
+    const bool optionalEntered=entered.load();
+    std::thread watchdog([&]{
+        while(!release && std::chrono::steady_clock::now()<deadline) std::this_thread::yield();
+        if(!release.exchange(true)) timedOut=true;
+    });
+    spare.open=true; executor.join(batch);
+    const bool rescuedBeforeRelease=!release.load();
+    presentation->cancel(); release=true; watchdog.join();
+    executor.join(first); executor.join(second); executor.cancelPresentationAndWait();
+    CHECK(optionalEntered); CHECK(rescuedBeforeRelease); CHECK_FALSE(timedOut.load()); CHECK(count==40);
+}
