+TEST_CASE("batch local terminal fan in survives immediate slot and result storage reuse" * doctest::test_suite("ComputeExecutor")) {
+    for(unsigned participants:{1u,2u,5u}) for(auto mode:{ComputeTelemetryMode::Off,ComputeTelemetryMode::Trace}) {
+        ComputeExecutor executor; executor.configureTelemetry(mode); executor.configure(participants);
+        for(unsigned repeat=0;repeat<128;++repeat) {
+            std::vector<unsigned> values(17,0);
+            const ComputeExecutor::Group group{values.size(),{[](void* input,std::size_t index) {
+                auto& row=*static_cast<std::vector<unsigned>*>(input); row[index]=unsigned(index+1);
+            },&values}};
+            auto batch=executor.submit(std::span(&group,1));
+            auto stale=batch;
+            executor.join(batch);
+            for(unsigned index=0;index<values.size();++index) CHECK(values[index]==index+1);
+            executor.join(stale); CHECK(executor.liveBatches()==0);
+            // values dies now, and next iteration immediately reuses owner slot.
+        }
+    }
+}
+TEST_CASE("retired batch storage cannot remain in another batch lane chain" * doctest::test_suite("ComputeExecutor")) {
+    if constexpr(!GAGCore::ThreadSupport::available) return;
+    ComputeExecutor executor; executor.configure(4); REQUIRE(executor.threadCount()==4);
+    std::atomic<unsigned> count{0}; ShardedHold held;
+    const auto increment=[](void* input,std::size_t){++*static_cast<std::atomic<unsigned>*>(input);};
+    const ComputeExecutor::Group head{1,{increment,&count},3},middle{1,{shardedHeld,&held},3},tail{1,{increment,&count},3};
+    auto first=executor.submit(std::span(&head,1),1);
+    auto second=executor.submit(std::span(&middle,1),2);
+    auto third=executor.submit(std::span(&tail,1),3);
+    executor.join(first); // Retires first node while its successor is running.
+    const auto enteredDeadline=std::chrono::steady_clock::now()+std::chrono::seconds(5);
+    while(!held.entered.load() && std::chrono::steady_clock::now()<enteredDeadline) std::this_thread::yield();
+    if(!held.entered.load()) {
+        held.open=true; executor.join(second); executor.join(third);
+        CHECK_MESSAGE(false,"lane successor must enter before slot reuse probe"); return;
+    }
+    const ComputeExecutor::Group loose{8,{increment,&count}};
+    auto recycled=executor.submit(std::span(&loose,1),4);
+    // Reuse the retired slot while the successor still holds. Static assignment
+    // can put independent work behind that hold, so release before joining it.
+    held.open=true; executor.join(recycled); executor.join(second); executor.join(third);
+    CHECK(count==10); CHECK(executor.liveBatches()==0);
+}
+TEST_CASE("concurrent batch local failures publish one error before finished" * doctest::test_suite("ComputeExecutor")) {
+    ComputeExecutor executor; executor.configure(5);
+    for(unsigned repeat=0;repeat<32;++repeat) {
+        const ComputeExecutor::Group group{16,{[](void*,std::size_t index){
+            if(index%3==0) throw std::runtime_error("parallel batch-local failure");
+        },nullptr}};
+        auto batch=executor.submit(std::span(&group,1));
+        CHECK_THROWS_AS(executor.join(batch),std::runtime_error);
+        CHECK(batch.empty()); CHECK(executor.liveBatches()==0);
+    }
