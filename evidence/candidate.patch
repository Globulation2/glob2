+TEST_CASE("idle steal peer consumes ready work assigned behind a busy worker" * doctest::test_suite("ComputeExecutor")) {
+    if constexpr(!GAGCore::ThreadSupport::available) return;
+    const auto* policy=std::getenv("GLOB2_DEFERRED_DISPATCH");
+    if(!policy || std::strcmp(policy,"steal")) return; // Run harness again with steal research policy.
+    ComputeExecutor executor; executor.configure(3);
+    REQUIRE(executor.threadCount()==3);
+    ShardedHold a,b;
+    const ComputeExecutor::Group holdBusy{1,{shardedHeld,&a}},holdIdle{1,{shardedHeld,&b}};
+    auto first=executor.submit(std::span(&holdBusy,1)); auto second=executor.submit(std::span(&holdIdle,1));
+    const auto enteredDeadline=std::chrono::steady_clock::now()+std::chrono::seconds(5);
+    while((!a.entered.load() || !b.entered.load()) && std::chrono::steady_clock::now()<enteredDeadline) std::this_thread::yield();
+    if(!a.entered.load() || !b.entered.load()) {
+        a.open=true; b.open=true; executor.join(first); executor.join(second);
+        CHECK_MESSAGE(false,"both worker gates must enter before stealing probe"); return;
+    }
+    auto& busy=a.slot==1 ? a : b;
+    auto& idle=a.slot==1 ? b : a;
+    idle.open=true;
+    if(a.slot==1) executor.join(second); else executor.join(first);
+    struct Work { std::mutex mutex; std::condition_variable done; bool ran=false; } work;
+    const ComputeExecutor::Group job{1,{[](void* value,std::size_t) {
+        auto& item=*static_cast<Work*>(value);
+        { std::lock_guard lock(item.mutex); item.ran=true; }
+        item.done.notify_one();
+    },&work}};
+    // Third ready job is statically assigned to first worker, still in busy hold.
+    auto queued=executor.submit(std::span(&job,1));
+    bool stolen=false;
+    { std::unique_lock lock(work.mutex); stolen=work.done.wait_for(lock,std::chrono::seconds(5),[&]{return work.ran;}); }
+    busy.open=true; executor.join(first); executor.join(second); executor.join(queued);
+    CHECK(stolen); CHECK(work.ran);
+}
