+namespace {
+struct ShardedHold { std::atomic<bool> entered{false},open{false}; std::atomic<std::size_t> slot{0}; };
+void shardedHeld(void* context,std::size_t) {
+    auto& gate=*static_cast<ShardedHold*>(context);
+    gate.slot=ComputeExecutor::workerSlot(); gate.entered=true;
+    while(!gate.open.load()) std::this_thread::yield();
+}
