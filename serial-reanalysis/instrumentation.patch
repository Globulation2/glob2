+#ifdef GLOB2_SERIAL_AUDIT
+#include <valgrind/callgrind.h>
+extern "C" void heaptrack_pause() __attribute__((weak));
+extern "C" void heaptrack_resume() __attribute__((weak));
+#include <cstdlib>
+#include <cstdio>
+#include <fcntl.h>
+#include <unistd.h>
+#include <time.h>
+#include <sys/syscall.h>
+static unsigned long long auditClock(clockid_t id) { timespec t{}; clock_gettime(id, &t); return t.tv_sec * 1000000000ULL + t.tv_nsec; }
+static unsigned long long auditOwner, auditProcess, auditWall;
+static void serialAuditControl(bool start)
+{
+    if (start) { if (heaptrack_resume) heaptrack_resume(); }
+    else if (heaptrack_pause) heaptrack_pause();
+    const char* control = std::getenv("GLOB2_AUDIT_CONTROL");
+    const char* ack = std::getenv("GLOB2_AUDIT_ACK");
+    if (control && ack) {
+    static int c = -1, a = -1;
+    if (start) { c = open(control, O_WRONLY); a = open(ack, O_RDONLY); }
+    if (c < 0 || a < 0) std::abort();
+    const char* command = start ? "enable\n" : "disable\n";
+    if (write(c, command, start ? 7 : 8) < 0) std::abort();
+    char reply[32];
+    if (read(a, reply, sizeof(reply)) <= 0) std::abort();
+    if (!start) { close(a); close(c); }
+    }
+    if (start) {
+        auditOwner = auditClock(CLOCK_THREAD_CPUTIME_ID);
+        auditProcess = auditClock(CLOCK_PROCESS_CPUTIME_ID);
+        auditWall = auditClock(CLOCK_MONOTONIC);
+    } else {
+        const auto wall = auditClock(CLOCK_MONOTONIC) - auditWall;
+        const auto process = auditClock(CLOCK_PROCESS_CPUTIME_ID) - auditProcess;
+        const auto owner = auditClock(CLOCK_THREAD_CPUTIME_ID) - auditOwner;
+        std::fprintf(stderr, "SERIAL_AUDIT_WINDOW owner_tid=%ld owner_cpu_ns=%llu process_cpu_ns=%llu wall_ns=%llu\n", syscall(SYS_gettid), owner, process, wall);
+    }
+}
+#endif
