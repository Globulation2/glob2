set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_CMAKE_SYSTEM_NAME Android)
set(VCPKG_CMAKE_SYSTEM_VERSION 24)
if(PORT STREQUAL "sdl2")
    set(VCPKG_LIBRARY_LINKAGE dynamic)
endif()
list(APPEND VCPKG_CMAKE_CONFIGURE_OPTIONS -DANDROID_PLATFORM=android-24 -DCMAKE_SYSTEM_VERSION=24)

# The pinned codecs predate CMake 3.5; CMake 4 requires an explicit policy floor.
list(APPEND VCPKG_CMAKE_CONFIGURE_OPTIONS -DCMAKE_POLICY_VERSION_MINIMUM=3.5)
