    {
      "id": "native:[stat work by job about]",
      "key": "[stat work by job about]",
      "source": "How many workers were supplying each kind of building: swarms (to make new units), inns (to make meals), buildings being built or upgraded, or other buildings such as towers, schools and barracks."
    },
    {
      "id": "native:[stat haul distance]",
      "key": "[stat haul distance]",
      "source": "Distance to resources"
    },
    {
      "id": "native:[stat haul distance about]",
      "key": "[stat haul distance about]",
      "source": "How far, on average, a harvesting worker was from the building it was supplying, in map squares in a straight line."
    },
    {
      "id": "native:[stat hauling]",
      "key": "[stat hauling]",
      "source": "Fetching and carrying"
    },
    {
      "id": "native:[stat hauling about]",
      "key": "[stat hauling about]",
      "source": "How the workers supplying buildings divided between walking to a resource, harvesting it, carrying materials back, and delivering it or waiting for a resource they can reach. Most of it is walking, so the closer the resources, the more gets done."
    },
    {
      "id": "native:[stat eating time]",
      "key": "[stat eating time]",
      "source": "Workers going to eat"
    },
    {
      "id": "native:[stat eating time about]",
      "key": "[stat eating time about]",
      "source": "How many workers were away from work to eat: walking to an inn, eating inside one, or hungry with no inn that could take them. Workers left with no inn means the colony has outgrown its inns or their food."
    },
    {
      "id": "native:[stat intruders]",
      "key": "[stat intruders]",
      "source": "Enemy warriors at home"
    },
    {
      "id": "native:[stat intruders about]",
      "key": "[stat intruders about]",
      "source": "How many enemy warriors were within 16 squares of the colony's buildings. Where two colonies are close together, each counts the other's defenders."
    },
    {
      "id": "native:[stat home defence]",
      "key": "[stat home defence]",
      "source": "Home defence strength margin"
    },
    {
      "id": "native:[stat home defence about]",
      "key": "[stat home defence about]",
      "source": "The strength of the colony's own warriors near its buildings minus that of the enemy warriors there, counting each warrior and each of its attack levels. Below zero the colony was outmatched at home."
    },
    {
      "id": "native:[stat combat death places]",
      "key": "[stat combat death places]",
      "source": "Where units fell in combat"
    },
    {
      "id": "native:[stat combat death places about]",
      "key": "[stat combat death places about]",
      "source": "Where the colony's units were when they were killed: near its own buildings, near an enemy's buildings, or in open ground between colonies. Losses at home mean the colony was being attacked; losses at an enemy colony mean it was attacking. Ground close to both colonies counts as home."
    },
