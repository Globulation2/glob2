      },
      {
        "translatedText": "पूर्ण झालेले बांधकाम: नवीन इमारती, सुधारणा आणि दुरुस्ती.",
        "model": "projects/888234813688/locations/global/models/general/nmt"
      },
      {
        "translatedText": "हल्ल्याची ताकद",
        "model": "projects/888234813688/locations/global/models/general/nmt"
      },
      {
        "translatedText": "वसाहतीच्या योद्ध्यांच्या एकत्रित युद्धशक्तीचा स्कोर: त्यांनी किती जोरदार आणि किती वेगाने हल्ला केला.",
        "model": "projects/888234813688/locations/global/models/general/nmt"
      },
      {
        "translatedText": "संरक्षण शक्ती",
        "model": "projects/888234813688/locations/global/models/general/nmt"
      },
      {
        "translatedText": "वसाहतीच्या संरक्षण बुरुजांच्या एकत्रित मारक क्षमतेसाठी दिलेला स्कोअर.",
        "model": "projects/888234813688/locations/global/models/general/nmt"
      },
      {
        "translatedText": "एकूण हिट पॉइंट्स",
        "model": "projects/888234813688/locations/global/models/general/nmt"
      },
      {
        "translatedText": "वसाहतीतील सर्व युनिट्स आणि इमारतींचे एकूण हिट पॉइंट्स.",
        "model": "projects/888234813688/locations/global/models/general/nmt"
      },
      {
        "translatedText": "झालेले नुकसान",
        "model": "projects/888234813688/locations/global/models/general/nmt"
      },
      {
        "translatedText": "वसाहतीने शत्रूच्या तुकड्या आणि इमारतींचे केलेले नुकसान. योद्धे, जादू आणि बुरुज पाहण्यासाठी तिचे विभाजन करा.",
        "model": "projects/888234813688/locations/global/models/general/nmt"
      },
      {
        "translatedText": "झालेले नुकसान",
        "model": "projects/888234813688/locations/global/models/general/nmt"
      },
      {
        "translatedText": "शत्रूंनी वसाहतीच्या तुकड्या आणि इमारतींना केलेले नुकसान.",
        "model": "projects/888234813688/locations/global/models/general/nmt"
      },
      {
        "translatedText": "नुकसान शिल्लक",
        "model": "projects/888234813688/locations/global/models/general/nmt"
      },
      {
        "translatedText": "दिलेले नुकसान वजा झालेले नुकसान. शून्याच्या वर असल्यास वसाहत आपल्या लढाया जिंकत होती.",
        "model": "projects/888234813688/locations/global/models/general/nmt"
      },
      {
        "translatedText": "लढाईत मारले गेलेले सैनिक",
        "model": "projects/888234813688/locations/global/models/general/nmt"
      },
      {
        "translatedText": "या वसाहतीचे घटक शत्रूंनी मारले. कामगार, शोधक आणि योद्धे स्वतंत्रपणे पाहण्यासाठी तिची विभागणी करा.",
        "model": "projects/888234813688/locations/global/models/general/nmt"
