    {
      "key": "native:[outcome reason prestige]",
      "severity": "major",
      "problem": "Prestige has changed from Heshima in core UI/help to Fahari here, obscuring the same score/victory mechanism.",
      "suggested_correction": "Replace Fahari/fahari with Heshima/heshima in this exact value.",
      "context": "Match [Prestige], [Prestige Score], [stat prestige], victory controls and relevant tutorial terminology. Both words can be legitimate alone; one glossary term must cover same mechanism.",
      "id": "SW-N-general-015-01",
      "state": "resolved-after-independent-editor-and-original-reviewer-recheck"
    },
    {
      "key": "native:[set library local help]",
      "severity": "minor",
      "problem": "hayasasi is malformed; intended negation of kusasisha is hayasasishi.",
      "suggested_correction": "Mabadiliko hayasasishi ramani nyingine au toleo la mtandaoni.",
      "context": "Preserves important promise that map-local edits do not update other maps or online release.",
      "id": "SW-N-general-015-02",
