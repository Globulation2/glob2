+std::vector<std::pair<std::string, Uint64>> Game::aiMetrics() const
+{
+	if (!aiPipeline)
+	{
+		auto values = teamStatsMetrics();
+		const auto hiring = hiringMetrics();
+		values.insert(values.end(), hiring.begin(), hiring.end());
+		return values;
+	}
+	const auto compute = map.computeExecutor().telemetrySnapshot();
+	const auto &waits =
+		compute.summary.joins[unsigned(ComputeProducer::AI)][unsigned(JoinReason::TickDeadline)];
+	const auto &capture = worldSnapshots.metrics;
+	const auto &scheduling = aiPipeline->schedulingMetrics();
