diff --git a/src/building/HiringDiagnostics.cpp b/src/building/HiringDiagnostics.cpp
new file mode 100644
index 000000000..64a5a1dca
--- /dev/null
+++ b/src/building/HiringDiagnostics.cpp
@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "HiringDiagnostics.h"
+#include "Building.h"
+#include "Unit.h"
+#include "Game.h"
+#include "Team.h"
+#include "HiringPlanner.h"
+#include <array>
+#include <chrono>
+#include <map>
+#include <ostream>
+#include <utility>
+
+namespace HiringDiagnostics
+{
+namespace
+{
+thread_local std::map<std::pair<std::uint16_t, std::uint32_t>, Row> rows;
+thread_local std::array<Row::Timing, Team::MAX_COUNT> periodic;
+std::uint64_t now()
+{
+	return std::chrono::duration_cast<std::chrono::nanoseconds>(
+			   std::chrono::steady_clock::now().time_since_epoch())
+		.count();
+}
+constexpr const char *phases[] = {"attempt", "consumption",          "subscription",
+								  "swap",    "field_initialization", "field_extension"};
+constexpr const char *counters[] = {
+	"visits",          "qualifications", "building_queries", "resource_queries", "hires",
+	"failed_attempts", "busy",           "rejected",         "missing_lists",    "exhausted_lists"};
+} // namespace
+thread_local Row *active = nullptr;
+std::atomic<bool> collecting{false};
+bool enabled()
+{
+	return collecting.load(std::memory_order_relaxed);
+}
+void configure(bool value)
+{
+	active = nullptr;
+	rows.clear();
+	periodic = {};
+	collecting.store(value, std::memory_order_relaxed);
+}
+PeriodicSwapScope::PeriodicSwapScope(const Team &value) : team(value.teamNumber)
+{
+	if (collecting)
+		start = now();
+}
+PeriodicSwapScope::~PeriodicSwapScope()
+{
+	if (start)
+	{
+		++periodic[team].calls;
+		periodic[team].ns += now() - start;
+	}
+}
+Scope::Scope(const Building &building, Phase value) : phase(value)
+{
+	if (!collecting)
+		return;
+	previous = active;
+	row = &rows[{building.gid, building.scriptIdentity}];
+	row->building = Game::refOf(&building);
+	row->tick = building.owner->game->stepCounter;
+	row->type = building.typeNum;
+	row->configuration = HiringPlanner::configuration(building);
+	active = row;
+	start = now();
+}
+Scope::Scope(Phase value) : phase(value)
+{
+	if (collecting.load(std::memory_order_relaxed))
+	{
+		row = active;
+		previous = active;
+		if (row)
+			start = now();
+	}
+}
+Scope::~Scope()
+{
+	if (!row)
+		return;
+	auto &timing = row->phases[unsigned(phase)];
+	++timing.calls;
+	timing.ns += now() - start;
+	active = previous;
+}
+void write(std::ostream &output)
+{
+	output << "{\"schema_version\":1,\"clock\":\"steady_elapsed_ns\",\"inclusive\":true,"
+			  "\"buildings\":[";
+	bool first = true;
+	for (const auto &[identity, row] : rows)
+	{
+		if (!first)
+			output << ',';
+		first = false;
+		output << "{\"team\":" << Building::GIDtoTeam(identity.first)
+			   << ",\"gid\":" << identity.first << ",\"generation\":" << identity.second
+			   << ",\"phases\":{";
+		for (unsigned i = 0; i < unsigned(Phase::Count); ++i)
+			output << (i ? "," : "") << '"' << phases[i] << "\":{\"calls\":" << row.phases[i].calls
+				   << ",\"ns\":" << row.phases[i].ns << '}';
+		output << "},\"counters\":{";
+		for (unsigned i = 0; i < unsigned(Counter::Count); ++i)
+			output << (i ? "," : "") << '"' << counters[i] << "\":" << row.counters[i];
+		output << "}}";
+	}
+	output << "],\"periodic_swaps\":[";
+	bool firstTeam = true;
+	for (unsigned team = 0; team < periodic.size(); ++team)
+		if (periodic[team].calls)
+		{
+			output << (firstTeam ? "" : ",") << "{\"team\":" << team
+				   << ",\"calls\":" << periodic[team].calls << ",\"ns\":" << periodic[team].ns
+				   << '}';
+			firstTeam = false;
+		}
+	output << "]}\n";
+}
+} // namespace HiringDiagnostics
diff --git a/src/building/HiringDiagnostics.h b/src/building/HiringDiagnostics.h
new file mode 100644
index 000000000..bd72e6e6a
--- /dev/null
+++ b/src/building/HiringDiagnostics.h
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <cstdint>
+#include <array>
+#include <iosfwd>
+#include "HiringJobs.h"
+#include <span>
+#include <vector>
+#include <atomic>
+class Building;
+class Unit;
+class Team;
+
+namespace HiringDiagnostics
+{
+enum class Phase : unsigned
+{
+	Attempt,
+	Consumption,
+	Subscription,
+	Swap,
+	FieldInitialization,
+	FieldExtension,
+	Count
+};
+enum class Counter : unsigned
+{
+	Visits,
+	Qualifications,
+	BuildingQueries,
+	ResourceQueries,
+	Hires,
+	FailedAttempts,
+	Busy,
+	Rejected,
+	MissingLists,
+	ExhaustedLists,
+	Count
+};
+struct Row
+{
+	struct Timing
+	{
+		std::uint64_t calls = 0, ns = 0;
+	};
+	std::array<Timing, unsigned(Phase::Count)> phases{};
+	std::array<std::uint64_t, unsigned(Counter::Count)> counters{};
+	BuildingRef building;
+	unsigned tick = 0;
+	int type = -1;
+	std::uint64_t configuration = 0;
+};
+extern thread_local Row *active;
+extern std::atomic<bool> collecting;
+// Explicit session configuration; diagnostic state never enters the game.
+void configure(bool enabled);
+bool enabled();
+inline void add(Counter counter, std::uint64_t count = 1)
+{
+	if (collecting.load(std::memory_order_relaxed) && active)
+		active->counters[unsigned(counter)] += count;
+}
+void write(std::ostream &output);
+class PeriodicSwapScope
+{
+	unsigned team;
+	std::uint64_t start = 0;
+
+  public:
+	explicit PeriodicSwapScope(const Team &);
+	~PeriodicSwapScope();
+};
+class Scope
+{
+	Row *row = nullptr;
+	Row *previous = nullptr;
+	Phase phase;
+	std::uint64_t start = 0;
+
+  public:
+	Scope(const Building &building, Phase phase);
+	explicit Scope(Phase phase); // Expensive route work attributed to its caller.
+	~Scope();
+	Scope(const Scope &) = delete;
+	Scope &operator=(const Scope &) = delete;
+};
+} // namespace HiringDiagnostics
diff --git a/src/building/HiringJobs.h b/src/building/HiringJobs.h
new file mode 100644
index 000000000..c318d48ae
--- /dev/null
+++ b/src/building/HiringJobs.h
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include "sim/EntityRef.h"
+#include <array>
+namespace Hiring
+{
+inline constexpr unsigned PublicationDelay = 4, RefreshInterval = 4, CandidateExtras = 2;
+// A vacancy just missed by an observation needs at most one refresh plus publication.
+inline constexpr unsigned RecruitmentRetryTicks = PublicationDelay + RefreshInterval;
+// Slot zero is delivery; the remaining slots are clearing, exploration and defense.
+inline std::array<unsigned, 4> roleTargets(unsigned seats, bool delivery, std::array<bool, 3> roles)
+{
+	std::array<unsigned, 4> result{};
+	const unsigned count =
+		unsigned(delivery) + unsigned(roles[0]) + unsigned(roles[1]) + unsigned(roles[2]);
+	if (!count)
+		return result;
+	unsigned rank = 0;
+	for (unsigned slot = 0; slot < result.size(); ++slot)
+		if (slot ? roles[slot - 1] : delivery)
+			result[slot] = seats / count + (rank++ < seats % count);
+	return result;
+}
+enum class Job : unsigned
+{
+	Delivery,
+	Fetch,
+	Clear,
+	Explore,
+	Defend
+};
+struct Key
+{
+	Job job;
+	int material = -1;
+	bool operator==(const Key &) const = default;
+};
+} // namespace Hiring
diff --git a/src/building/HiringPipeline.cpp b/src/building/HiringPipeline.cpp
new file mode 100644
index 000000000..bcbb66e32
