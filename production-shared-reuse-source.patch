+SimulationSnapshot::Handle
+Game::captureReadBoundary(SimulationSnapshot::CaptureOptions options) const
+{
+	return worldSnapshots.captureBoundary(*this, options);
+}
+SimulationSnapshot::Handle Game::prepareReadBoundary(bool paused,
+													 SimulationSnapshot::CaptureOptions options)
+{
+	const bool statisticsActive = !paused && !anyPlayerWaited;
+	// Hiring observes the completed world before matched orders, even while a
+	// replica waits or is paused. Gating admission on local readiness can let
+	// another replica first observe after orders at the same numbered boundary.
+	if (!hiringPipeline)
+		hiringPipeline = std::make_unique<HiringPipeline>(map.computeExecutor());
+	hiringPipeline->publishDue(stepCounter);
+	if (statisticsActive)
+	{
+		if (statsPipeline && !statsPipeline->matchesWorld(map.identity()))
+			statsPipeline.reset();
+		if (!statsPipeline)
+			statsPipeline = std::make_unique<TeamStatsPipeline>(map.computeExecutor());
+		for (int t = 0; t < teamsCount(); ++t)
+			teams[t]->stats.enableCollection();
+		if (statsPipeline->publishDue(*this))
+			worldSnapshots.invalidateBoundary();
+	}
+	auto world = worldSnapshots.captureBoundary(*this, options);
+	if (statisticsActive && statsPipeline->needsSample(stepCounter))
+	{
+		statsPipeline->prepareBoundary(*this, world);
+		if (statsPipeline->publishDue(*this))
+		{
+			worldSnapshots.invalidateBoundary();
+			world = worldSnapshots.captureBoundary(*this, options);
+		}
+	}
+	hiringPipeline->observe(*this, world);
+	return world;
+}
+std::vector<std::pair<unsigned, std::shared_ptr<Order>>>
+Game::prepareAIOrders(std::span<const unsigned> players, bool paused,
+					  const std::shared_ptr<GameDiagnostics::Session> &diagnostics,
+					  const SimulationSnapshot::Handle *captured)
+{
+	if (!aiPipeline)
+		aiPipeline = std::make_unique<AIEngine::Pipeline>();
+	// Standalone simulation callers use the same boundary service; engine callers
+	// supply the standard snapshot already published at this boundary.
+	if (captured)
+		return aiPipeline->prepare(*this, players, paused, diagnostics, *captured);
+	const auto world =
+		prepareReadBoundary(paused, diagnostics ? diagnostics->captureOptions(stepCounter)
+												: SimulationSnapshot::CaptureOptions{});
+	return aiPipeline->prepare(*this, players, paused, diagnostics, world);
+}
