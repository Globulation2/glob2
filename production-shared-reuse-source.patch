diff --git a/src/building/HiringRanking.h b/src/building/HiringRanking.h
new file mode 100644
index 000000000..a29e8175a
--- /dev/null
+++ b/src/building/HiringRanking.h
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <cstdint>
+
+// Pure comparisons over already-qualified candidates. Equal keys retain the
+// caller's traversal order; snapshot planners supply identity-ordered ties.
+namespace HiringRanking
+{
+constexpr std::int64_t materialLevel(int construction, int walking)
+{
+	return std::int64_t(construction) * 10 + walking;
+}
+constexpr bool materialBetter(std::int64_t level, std::int64_t value, std::int64_t bestLevel,
+							  std::int64_t bestValue)
+{
+	return level > bestLevel || (level == bestLevel && value < bestValue);
+}
+constexpr bool roleBetter(int role, std::int64_t level, std::int64_t value, std::int64_t bestLevel,
+						  std::int64_t bestValue)
+{
+	return (role == 2 ? level > bestLevel : level < bestLevel) ||
+		   (level == bestLevel && value < bestValue);
+}
+} // namespace HiringRanking
