diff --git a/src/map/gradient/ResearchClassGate.h b/src/map/gradient/ResearchClassGate.h
new file mode 100644
index 000000000..a624c24a9
--- /dev/null
+++ b/src/map/gradient/ResearchClassGate.h
@@ -0,0 +1,74 @@
+// Local attribution experiment only. Never ship or merge this header.
+#pragma once
+#include "Game.h"
+#include "Team.h"
+#include "TeamCapacity.h"
+#include "SnapshotGradient.h"
+#include <array>
+#include <cstdlib>
+#include <cstdint>
+#include <fstream>
+#include <stdexcept>
+
+namespace research_class_gate {
+enum Family { Materials,Markets,Guard,Clear,Forbidden,FamilyCount };
+inline bool enabled() {
+    static const bool value=[] {
+        const char* text=std::getenv("GLOB2_RESEARCH_CLASS_GATE");
+        if(!text || std::string(text)=="0")return false;
+        if(std::string(text)=="1")return true;
+        throw std::invalid_argument("Research class gate must be0 or1");
+    }();
+    return value;
+}
+inline const std::string& reportPath() {
+    static const std::string path=[] {const char* p=std::getenv("GLOB2_RESEARCH_CLASS_REPORT");return p?std::string(p):std::string{};}();
+    return path;
+}
+inline bool diagnosticsEnabled() {return !reportPath().empty();}
+inline void initialize() {(void)enabled();(void)reportPath();}
+using Counts=std::array<std::array<std::array<std::uint64_t,MOVEMENT_CLASS_COUNT>,TEAM_MAX_COUNT>,FamilyCount>;
+inline Counts visits{},zeroClassVisits{},admissions{};
+inline std::uint64_t consumerAdmissions=0,coldAdmissions=0,warmAdmissions=0;
+inline void resetStatistics() {if(diagnosticsEnabled()){visits={};zeroClassVisits={};admissions={};consumerAdmissions=coldAdmissions=warmAdmissions=0;}}
+inline bool periodicAllowed(const Game& game,int team,int movement,Family family) {
+    const auto& m=game.teams[team]->stats.measurements();
+    const bool knownZero=movement<AIR_MOVEMENT_CLASS && m.researchMovementKnown && !m.researchMovementCounts[movement];
+    if(diagnosticsEnabled()) {
+        ++visits[family][team][movement];
+        zeroClassVisits[family][team][movement]+=knownZero;
+    }
+    return !enabled() || !knownZero;
+}
+inline void admitted(const gradient_preparation::Request& request,bool warm) {
+    if(!diagnosticsEnabled())return;
+    ++admissions[int(request.kind)][request.team][request.swim];
+    consumerAdmissions+=request.consumer>=0;
+    warmAdmissions+=warm;coldAdmissions+=!warm;
+}
+inline void writeReport(const Game& game) {
+    if(!diagnosticsEnabled())return;
+    std::ofstream out(reportPath());if(!out)throw std::runtime_error("Cannot write research class report");
+    out<<"{\"research_only\":true,\"class_gate\":"<<(enabled()?"true":"false")
+       <<",\"counter_window\":\"measured benchmark window; otherwise full run\",\"consumer_admissions\":"<<consumerAdmissions
+       <<",\"cold_admissions\":"<<coldAdmissions<<",\"warm_admissions\":"<<warmAdmissions<<",\"teams\":[";
+    for(int team=0;team<game.teamsCount();++team) {
+        if(team)out<<',';const auto& m=game.teams[team]->stats.measurements();
+        out<<"{\"team\":"<<team<<",\"sample_tick\":"<<m.tick<<",\"known\":"<<(m.researchMovementKnown?"true":"false")<<",\"ground_bins\":[";
+        for(int movement=0;movement<SWIM_CLASS_COUNT;++movement){if(movement)out<<',';out<<m.researchMovementCounts[movement];}
+        out<<"],\"families\":[";
+        for(int family=0;family<FamilyCount;++family) {
+            if(family)out<<',';out<<"{\"family\":"<<family<<",\"movement\":[";
+            for(int movement=0;movement<MOVEMENT_CLASS_COUNT;++movement) {
+                if(movement)out<<',';out<<"{\"class\":"<<movement<<",\"periodic_candidates\":"<<visits[family][team][movement]
+                    <<",\"known_zero_candidates\":"<<zeroClassVisits[family][team][movement]
+                    <<",\"skipped\":"<<(enabled()?zeroClassVisits[family][team][movement]:0)
+                    <<",\"admissions\":"<<admissions[family][team][movement]<<'}';
+            }
+            out<<"]}";
+        }
+        out<<"]}";
+    }
+    out<<"]}\n";
+}
+} // namespace research_class_gate
