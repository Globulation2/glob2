+// Artifact-only CPU attribution selector. Never creates an observer or an
+// exploration object: the existing fixedInterval argument is the only policy
+// change. Parse once, eagerly called by headless startup before world loading.
+unsigned researchGradientFixedInterval()
+{
+    static const unsigned interval=[] {
+        const char* raw=std::getenv("GLOB2_RESEARCH_GRADIENT_INTERVAL");
+        if(!raw)return 0u;
+        const std::string_view text(raw);unsigned value=0;
+        const auto parsed=std::from_chars(text.data(),text.data()+text.size(),value);
+        if(parsed.ec!=std::errc{} || parsed.ptr!=text.data()+text.size()
+            || (value!=0 && value!=8 && value!=32 && value!=128))
+            throw std::invalid_argument("GLOB2_RESEARCH_GRADIENT_INTERVAL must be exactly 0, 8, 32 or 128");
+        return value;
+    }();
+    return interval;
+}
