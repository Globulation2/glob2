+TEST_CASE("sharded queues preserve lane order across repeated groups exceptions and slot reuse" * doctest::test_suite("ComputeExecutor")) {
+    for(unsigned threads:{1u,2u,5u}) for(auto mode:{ComputeTelemetryMode::Off,ComputeTelemetryMode::Trace}) {
+        ComputeExecutor executor;
+        executor.configureTelemetry(mode); executor.configure(threads);
+        struct Context { std::atomic<unsigned> next{0},overlap{0},active{0}; } context;
+        const auto callback=[](void* value,std::size_t) {
+            auto& state=*static_cast<Context*>(value);
+            if(state.active.fetch_add(1)) ++state.overlap;
+            ++state.next; state.active.fetch_sub(1);
+        };
+        for(unsigned repeat=0;repeat<3;++repeat) {
+            std::array<ComputeExecutor::Group,4> groups{{{3,{callback,&context},4},{0,{callback,&context},4},{2,{callback,&context},4},{1,{callback,&context},7}}};
+            // Separate state for independent lane: only the ordered lane is checked for overlap.
+            Context other; groups[3].job.context=&other;
+            auto first=executor.submit(groups,10+repeat);
+            auto stale=first;
+            const ComputeExecutor::Group tail{2,{callback,&context},4};
+            auto second=executor.submit(std::span(&tail,1),10+repeat);
+            executor.join(second); executor.join(first); executor.join(stale);
+            CHECK(context.next==(repeat+1)*7); CHECK(context.overlap==0);
+            CHECK(other.next==1); CHECK(executor.liveBatches()==0);
+        }
+        const ComputeExecutor::Group fail{1,{[](void*,std::size_t){throw std::runtime_error("queue failure");},nullptr},4};
+        const ComputeExecutor::Group tail{1,{callback,&context},4};
+        auto first=executor.submit(std::span(&fail,1),20); auto second=executor.submit(std::span(&tail,1),20);
+        CHECK_THROWS_AS(executor.join(first),std::runtime_error); executor.join(second);
+        CHECK(context.next==22); CHECK(context.overlap==0);
+        executor.configure(threads); CHECK(executor.liveBatches()==0);
+    }
+}
