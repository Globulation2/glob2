import os

Import("env")
Import("PackTar")

if env.get('OPTIMIZED_ASSET_INSTALL') and 'dist' not in COMMAND_LINE_TARGETS:
    Return()

if 'dist' in COMMAND_LINE_TARGETS or 'install' in COMMAND_LINE_TARGETS:
    for directory, dirs, files in os.walk('.'):
        dirs.sort()
        for name in sorted(files):
            if not name.endswith(('.sgsl', '.js', '.json')):
                continue
            path = os.path.join(directory, name)
            PackTar(env['TARFILE'], path)
            env.Install(os.path.join(env['INSTALLDIR'], 'glob2', 'scripts', directory), path)
    env.Alias('install', env['INSTALLDIR'] + '/glob2/scripts')
    PackTar(env['TARFILE'], 'SConscript')
