+            logarithm = math.log1p(duration / offset)
+            slope = (last - first) / (1000 * duration)
+            parts.append(first / 1000 * logarithm + slope * (duration - offset * logarithm))
+        area = math.fsum(parts) / math.log1p(SCORE_COEFFICIENT)
